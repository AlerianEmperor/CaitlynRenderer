vec3 sample_light_position(int li)
{
    Light4 l = lights[li];
    vec3 p = l.p.xyz;
    vec3 u = l.u.xyz;
    vec3 v = l.v.xyz;
    float s = sqrt(rand());
    float b0 = 1.0f - s;
    float b1 = rand() * s;
    return p + b0 * u + b1 * v;
}

vec3 path_trace(inout Ray r)
{
	vec3 L = vec3(0.0f);
	vec3 T = vec3(1.0f);

	float prev_pdf = 1.0f;


	//Ray new_ray = r;
	bool is_specular = true;

	for(int i = 0; i < 3; ++i)
	{
        if (i >= 1)
	    {
	        // Max throughput component determines survival probability
			float p = max(T.x, max(T.y, T.z));
			
			// Cap the survival probability to prevent infinite energy variance
			//if (p > 0.95f) p = 0.95f; 
            if (p > 0.6f) p = 0.6f; 

			// Use your rand() function to evaluate Russian Roulette condition
			if (rand() > p)
			{
		        break; // Terminate the ray path early
			}

			// Unbias the throughput vector with the survival probability
			T /= p; 
		}
	    HitRecord rec;
		
        if(trace_bvh_dfs(r, rec))
        //if(trace_bvh_dfs_bitstack(r, rec))
        //if(trace_bvh_dfs_vectorized(r, rec))
        {
			float cos_incident = dot(r.d, rec.n);

			vec3 original_n = rec.n;

			if (cos_incident > 0)
				rec.n = -rec.n;

			vec4 emission = rec.emission;

			if(emission.w != -1)
			{
				if(!is_specular)
				{
					vec3 light_direction = r.d * rec.t;

					float length = length(light_direction);

					light_direction = normalize(light_direction);

					float cos_light = (-dot(light_direction, rec.n));//ko can abs

					float length2 = length * length;

					int light_index = int(emission.w);//int(vt.w);

					
					//Light4 l = lights[light_index];
					//vec3 light_area_pdf = l.area_pdf.xyz;

                    vec3 light_area_pdf = lights[light_index].area_pdf.xyz;
					
                    float pdf_light = length2 / (light_area_pdf.x * cos_light) * light_area_pdf.y;
					float mis_weight = power_heuristic(prev_pdf, pdf_light);

					
					L += T * emission.xyz * mis_weight;

					return L;
				}
                else
				{
					L += T * emission.xyz;
					return L;
				}
			}

			vec3 hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

            vec4 specular = rec.specular;

			if(specular.w == 0)
			{
				int light_index = int(rand() * numLights);
				
				vec3 light_position = sample_light_position(light_index);

				vec3 light_direction = light_position - hit_point;

				float length = length(light_direction);

				float ilength = 1.0f / length;

				light_direction *= ilength;

				float cos_mtl = dot(light_direction, original_n);

				//float cos_light = dot(light_direction, rec.n);

				Ray light_ray = Ray(hit_point, light_direction);

                //Ray light_ray = Ray(light_position, -light_direction);

				Light4 l = lights[light_index];

				vec3 light_normal = l.n.xyz;
				
				float cos_light = ((dot(light_direction, light_normal)));

                if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_dfs(light_ray, length))		
                {	
					//Light4 l = lights[light_index];
					
					vec3 light_emission = l.e.xyz;
					
					vec3 light_area_pdf = l.area_pdf.xyz;
					
					float pdf_light = (length * length) / (light_area_pdf.x * -cos_light) * light_area_pdf.y;

					vec3 bsdf_eval = diffuse_bsdf(r, rec, light_direction);

					float bsdf_pdf = diffuse_pdf(r, rec, light_direction);

                    //divide pdf_light
					//float mis_weight = power_heuristic(pdf_light, bsdf_pdf);

                    //normal no clamp
					//L += T * light_emission * bsdf_eval * mis_weight / pdf_light;

                    //already divide pdf_light
                    float mis_weight = power_heuristic_divide(pdf_light, bsdf_pdf);

                    L += T * light_emission * bsdf_eval * mis_weight;// / pdf_light;

                    //vec3 incoming_L = T * light_emission * bsdf_eval * mis_weight / pdf_light;

                    // Ng?n ch?n các tia n?y may m?n mang n?ng l??ng vô lý phá ho?i b?c tranh (Firefly)
                    //float max_allowed_intensity = 5.0f; // B?n có th? tinh ch?nh t? 2.0f ??n 10.0f tùy ?? r?c c?a l?a
                    //incoming_L = clamp(incoming_L, vec3(0.0f), vec3(max_allowed_intensity));

                    //vec3 incoming_L = T * light_emission * bsdf_eval * mis_weight / pdf_light;

                    // Ch? t?n 1 chu k? ph?n c?ng c?a GPU thay vì 6 chu k? nh? hàm clamp c?
                    //incoming_L = min(incoming_L, vec3(10.0f)); 

                    //L += incoming_L;
					
				}
			}

			//Sample for new ray
			vec3 sample_direction = diffuse_sample(r, rec.n);
			vec3 new_hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

			vec3 sample_eval = diffuse_bsdf(r, rec, sample_direction);

			float bsdf_pdf = diffuse_pdf(r, rec, sample_direction);

            //no russian roulette
			T *= sample_eval;

            float energy = max(T.x, max(T.y, T.z));
            if (energy < 0.01f) 
            {
                break; 
            }
               

			prev_pdf = bsdf_pdf;

			is_specular = false;

			r.o = new_hit_point;
			r.d = sample_direction;

			//r = Ray(new_hit_point, sample_direction);
		}
		else
			return L;
	}
	return L;
}



//best
void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(screenResolution.x) || pixelCoords.y >= int(screenResolution.y))  
        return;   

    if (gl_LocalInvocationIndex == 0)
        shared_workgroup_active = false;

    float current_variance = 0.0f;
    float current_luminance = 0.0f;
    vec4 history_data = vec4(0.0f);

    history_data = imageLoad(variance_history_tex, pixelCoords);
    float history_mean_lum = history_data.r;//light source, whiout this, light will get weaker and grayer
    float history_m2 = history_data.a;

    if(currentFrameSample > MIN_SAMPLES)
        current_variance = history_m2 / float(currentFrameSample - 1);
    else
        current_variance = 1.0f;

    if (history_mean_lum > 1.5f) 
    {
        current_variance = 1.0f; // B?t bu?c cày ti?p, không cho phép skip s?m
    }

    if(current_variance > VARIANCE_THRESHOLD)
        shared_workgroup_active = true;

   // ??ng b? hóa tr?ng thái b? nh? Shared sau khi toàn b? lu?ng ?ã b? phi?u
    memoryBarrierShared();
    barrier();

    // ============================================================
    // B?Y WARP DIVERGENCE ???C GI?I QUY?T ? ?ÂY
    // N?u c? c?m 8x8 ??u có variance < threshold, shared_workgroup_active s? gi? nguyên là false.
    // Toàn b? 64 lu?ng (Warp) cùng thoát ??ng th?i, tri?t tiêu lãng phí chu k? c?a GPU!
    // ============================================================
    if (!shared_workgroup_active)
    {
        return; 
    }

    vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f)) / screenResolution;
	
    // T?o Jitter TAA theo khung hình gi?ng b?n main_final c?a b?n
    float jitter_offset_x = (currentFrameSample % 2 == 0) ? 0.25f : -0.25f;
    float jitter_offset_y = ((currentFrameSample / 2) % 2 == 0) ? 0.25f : -0.25f;
    vec2 jittered_uv = (vec2(pixelCoords) + vec2(0.5f) + vec2(jitter_offset_x, jitter_offset_y)) / screenResolution;
    seed = jittered_uv;

    //normal
	float r1 = 2.0f * rand();
	float r2 = 2.0f * rand();

	vec2 jitter;

	jitter.x = r1 < 1.0 ? sqrt(r1) - 1.0f : 1.0f - sqrt(2.0f - r1);
	jitter.y = r2 < 1.0 ? sqrt(r2) - 1.0f : 1.0f - sqrt(2.0f - r2);
	jitter /= (screenResolution * 0.5f);

	vec2 d = (2.0f * texCoords - 1.0f) + jitter;

	float tan_fov = tan(camera.fov * 0.5f);
	d.x *= screenResolution.x / screenResolution.y * tan_fov;
	d.y *= tan_fov;

	vec3 rayDir = normalize(d.x * camera.right + d.y * camera.up + camera.forward);

	Ray ray = Ray(camera.position, rayDir);

	vec3 accumulate_color = texture(accumulate_tex, texCoords).xyz;
    
    vec3 pixelColor = path_trace(ray);

    //fail
    //vec3 pixelColor = path_trace_wald(ray);

    vec3 final_color = pixelColor + accumulate_color;

    imageStore(img_output, pixelCoords, vec4(pixelColor + accumulate_color, 1.0f));


    // ============================================================
    // THU?T TOÁN WELFORD TÍNH VARIANCE ONLINE (CHUY?N HÓA SANG GLSL)
    // ============================================================
    // Trích xu?t s?c ?? (Luminance) c?a m?u màu hi?n t?i
    float new_luminance = dot(pixelColor, vec3(0.2126, 0.7152, 0.0722));
        
    float old_mean = history_data.r;
    float old_m2 = history_data.a;
        
    // 1. C?p nh?t giá tr? trung bình ch?y l?y ti?n (Running Mean)
    float current_sample_weight = 1.0f / float(currentFrameSample + 1);
    float new_mean = mix(old_mean, new_luminance, current_sample_weight);
        
    // 2. Tính toán t?ng bình ph??ng kho?ng cách sai s? l?y ti?n (Running M2)
    float delta0 = new_luminance - old_mean;
    float delta1 = new_luminance - new_mean;
    float new_m2 = old_m2 + delta0 * delta1;

    // L?u ng??c l?i Texture phân tích ?? chu?n b? cho khung hình ti?p theo
    imageStore(variance_history_tex, pixelCoords, vec4(new_mean, 0.0f, 0.0f, new_m2));
}
