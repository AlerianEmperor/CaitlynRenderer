float rand()
{
    seed -= vec2(randomVector.x * randomVector.y);
    uint state = floatBitsToUint(seed.x * 1234567.0 + seed.y * 7654321.0);
    return fract(sin(dot(seed, vec2(12.9898, 78.233))) * 43758.5453);
}

void onb(in vec3 n, out vec3 b1, out vec3 b2)
{
    if (n.z < -0.999f) {
        b1 = vec3(0, -1, 0);
        b2 = vec3(-1, 0, 0);
    } else {
        float a = 1.0 / (1.0 + n.z);
        float b = -n.x * n.y * a;
        b1 = vec3(1.0 + b, b, -n.x);
        b2 = vec3(b, 1.0 + b, -n.y);
    }
}

struct HitRecord
{
    vec4 albedo;  
    vec4 emission;
    vec4 specular;
    vec4 tex_ind;
    vec3 n;
    vec2 texcoord;
    float u;
    float v;
