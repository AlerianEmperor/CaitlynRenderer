    int mtl_ind;
};

float power_heuristic(float a, float b)
{
    float t = a * a;
    return t / (b * b + t);
}

float power_heuristic_divide(float a, float b)
{
    return a / (b * b + a * a);
}

vec3 cosine_hemisphere_sampling()
{
    float u1 = rand();
    float u2 = rand();
    float r = sqrt(u1);
    float phi = pi2 * u2;
    return vec3(r * cos(phi), r * sin(phi), sqrt(1.0f - u1));
}

vec3 diffuse_sample(in Ray r, vec3 n)
{
    vec3 u, v;
    onb(n, u, v);
    vec3 dir = cosine_hemisphere_sampling();
    dir = u * dir.x + v * dir.y + n * dir.z;
    return dir;
}

float diffuse_pdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    float cos = dot(sample_direction, rec.n);
    return cos * ipi;
}

vec3 diffuse_bsdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    return rec.albedo.xyz;
} 

vec2 interpolate(vec2 a, vec2 b, vec2 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }
vec3 interpolate(vec3 a, vec3 b, vec3 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }


float hit_bbox(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, out float tl)
{
    vec3 t1 = (bmin - r.o) * invdir;
    vec3 t2 = (bmax - r.o) * invdir;
    
    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);
    
    tl = max(tmin.x, max(tmin.y, tmin.z));
    float th = min(tmax.x, min(tmax.y, tmax.z));
    return th; 
}


ivec3 get_ray_sign(vec3 invdir) 
{
    return ivec3(lessThan(invdir, vec3(0.0)));
}


//best
bool hit_bbox4(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, vec3 ox_invdir, out float tl, float t)
{
    vec3 t1 = bmin * invdir + ox_invdir;
    vec3 t2 = bmax * invdir + ox_invdir;

    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);

    // T?n d?ng t?i ?a t?p l?nh gi?m c?p ph?n c?ng (Reduction)
    tl = max(max(tmin.x, tmin.y), tmin.z);
    float th = min(min(tmax.x, tmax.y), tmax.z);

    return (tl <= th && th >= 0.0 && tl < t);
}

bool hit_bbox4_no_t(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, vec3 ox_invdir, out float tl)
{
    vec3 t1 = bmin * invdir + ox_invdir;
    vec3 t2 = bmax * invdir + ox_invdir;

    vec3 tmin = min(t1, t2);
    vec3 tmax = max(t1, t2);

    // T?n d?ng t?i ?a t?p l?nh gi?m c?p ph?n c?ng (Reduction)
    tl = max(max(tmin.x, tmin.y), tmin.z);
    float th = min(min(tmax.x, tmax.y), tmax.z);

    return (tl <= th && th >= 0.0);
}

bool hit_bbox4_prune(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, float t, out float tl)
{
    bvec3 is_pos = greaterThanEqual(invdir, vec3(0.0));

    vec3 t1 = mix(bmax, bmin, is_pos);
    t1 = (t1 - r.o) * invdir;
    tl = max(max(t1.x, t1.y), t1.z);

    if(tl >= t)
        return false;

    vec3 t2 = mix(bmin, bmax, is_pos);
    t2 = (t2 - r.o) * invdir;

    float th = min(min(t2.x, t2.y), t2.z);

    return (th >= 0) && (th >= tl);// && 
}

