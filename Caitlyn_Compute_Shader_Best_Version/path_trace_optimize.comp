float hit_bbox_axis_dominant(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, out float tl)
{
    // 1. Identify the dominant axis (the component with the largest magnitude)
    vec3 abs_d = abs(r.d);
    int dominant_axis = (abs_d.x > abs_d.y) ? ((abs_d.x > abs_d.z) ? 0 : 2) : ((abs_d.y > abs_d.z) ? 1 : 2);
    
    // 2. Precompute the non-dominant axes indices
    int idx_u = (dominant_axis + 1 == 3) ? 0 : dominant_axis + 1;
    int idx_v = (idx_u + 1 == 3) ? 0 : idx_u + 1;
    
    // 3. Compute early interval limits directly along the dominant axis
    // Since the ray is normalized along this axis, no min/max for this component is required
    float t_near_dom = (invdir[dominant_axis] >= 0.0f) ? (bmin[dominant_axis] - r.o[dominant_axis]) * invdir[dominant_axis] 
                                                       : (bmax[dominant_axis] - r.o[dominant_axis]) * invdir[dominant_axis];
    float t_far_dom  = (invdir[dominant_axis] >= 0.0f) ? (bmax[dominant_axis] - r.o[dominant_axis]) * invdir[dominant_axis] 
                                                       : (bmin[dominant_axis] - r.o[dominant_axis]) * invdir[dominant_axis];

    // 4. Transform and project the remaining two non-dominant dimensions
    float t1u = (invdir[idx_u] >= 0.0f) ? bmin[idx_u] : bmax[idx_u];
    float t2u = (invdir[idx_u] >= 0.0f) ? bmax[idx_u] : bmin[idx_u];
    float tmin_u = (t1u - r.o[idx_u]) * invdir[idx_u];
    float tmax_u = (t2u - r.o[idx_u]) * invdir[idx_u];

    float t1v = (invdir[idx_v] >= 0.0f) ? bmin[idx_v] : bmax[idx_v];
    float t2v = (invdir[idx_v] >= 0.0f) ? bmax[idx_v] : bmin[idx_v];
    float tmin_v = (t1v - r.o[idx_v]) * invdir[idx_v];
    float tmax_v = (t2v - r.o[idx_v]) * invdir[idx_v];

    // 5. Compute consolidated entry and exit bounds (Branchless max/min)
    tl = max(t_near_dom, max(tmin_u, tmin_v));
    float th = min(t_far_dom, min(tmax_u, tmax_v));
    
    return th; 
}

