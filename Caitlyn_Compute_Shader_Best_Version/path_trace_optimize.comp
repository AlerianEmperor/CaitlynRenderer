};

vec3 cosine_hemisphere_sampling()
{
    float u1 = rand();
    float u2 = rand();
    float r = sqrt(u1);
    float phi = pi2 * u2;
    return vec3(r * cos(phi), r * sin(phi), sqrt(1.0f - u1));
}

vec3 diffuse_sample(in Ray r, vec3 n)
{
    vec3 u, v;
    onb(n, u, v);
    vec3 dir = cosine_hemisphere_sampling();
    dir = u * dir.x + v * dir.y + n * dir.z;
    return dir;
}

float diffuse_pdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    float cos = dot(sample_direction, rec.n);
    return cos * ipi;
}

vec3 diffuse_bsdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    return rec.albedo.xyz;
} 

vec2 interpolate(vec2 a, vec2 b, vec2 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }
vec3 interpolate(vec3 a, vec3 b, vec3 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }

bool hit_triangle(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    vec3 tv = r.o - v0;
    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    vec4 uvt;
    uvt.x = dot(tv, pv);
    uvt.y = dot(r.d, qv);
    uvt.z = dot(v2, qv);
    float inv_det = 1.0f / dot(v1, pv);

    uvt.xyz = uvt.xyz * inv_det;
    uvt.w = 1.0 - uvt.x - uvt.y;
    
    if (all(greaterThanEqual(uvt, vec4(0.0f))) && uvt.z < t)
    {
        t = uvt.z;
        rec.u = uvt.x;
        rec.v = uvt.y;
        rec.triangle_ind = i;
        rec.mtl_ind = (triIndex.w);
        return true;
    }   
    return false;
}

bool hit_triangle2(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = -vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz + v0;
    vec3 v2 = vertices[triIndex.z].xyz + v0;

    vec3 pv = cross(r.d, v2);
    float det = dot(v1, pv);

    //front face only
    // if 2 face use abs(det)
    if (abs(det) < 1e-6) return false;
    float inv_det = 1.0f / det;

    vec3 tv = r.o + v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0 ) return false;

    vec3 qv = cross(tv, v1);
    float v = dot(r.d, qv) * inv_det;
    if (v < 0.0 || v > 1.0 || u + v > 1.0) return false;

    /*vec3 tv = r.o + v0;
    float u = dot(tv, pv) * inv_det;
    
    vec3 qv = cross(tv, v1);
    float v = dot(r.d, qv) * inv_det;

    if (u < 0.0 || v < 0.0 || (u + v) > 1.0) return false;*/

    float t_hit = dot(v2, qv) * inv_det;
    
    if (t_hit > 0.0 && t_hit < t)
    {
        t = t_hit;
        rec.u = u;
        rec.v = v;
        rec.triangle_ind = i;
        rec.mtl_ind = triIndex.w;
        return true;
    }   
    return false;
}

bool hit_triangle_fast(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = -vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz + v0;
    vec3 v2 = vertices[triIndex.z].xyz + v0;

    vec3 pv = cross(r.d, v2);
    float det = dot(v1, pv);

    if (abs(det) < 1e-6) return false;
    float inv_det = 1.0f / det;

    vec3 tv = r.o + v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qv = cross(tv, v1);
    float v = dot(r.d, qv) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;

    float t_hit = dot(v2, qv) * inv_det;
    
    if (t_hit > 0.0 && t_hit < t)
    {
        t = t_hit;
        rec.u = u;
        rec.v = v;
        rec.triangle_ind = i;
        rec.mtl_ind = triIndex.w;
        return true;
    }   
    return false;
}

//qua te
bool hit_triangle_watertight(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz;
    vec3 v2 = vertices[triIndex.z].xyz;

    // 1. Calculate dimension permutation based on ray direction absolute values
    // Find the coordinate axis where the ray direction is dominant
    vec3 abs_d = abs(r.d);
    int kz = (abs_d.x > abs_d.y) ? ((abs_d.x > abs_d.z) ? 0 : 2) : ((abs_d.y > abs_d.z) ? 1 : 2);
    int kx = (kz + 1 == 3) ? 0 : kz + 1;
    int ky = (kx + 1 == 3) ? 0 : kx + 1;

    // Swap kx and ky if ray direction along kz is negative to preserve winding order
    if (r.d[kz] < 0.0f) {
        int tmp = kx; kx = ky; ky = tmp;
    }
    float invd = 1.0f / r.d[kz];
    // 2. Calculate shear constants to transform triangles into Ray-Space
    float sx = r.d[kx] * invd;// / r.d[kz];
    float sy = r.d[ky] * invd;// / r.d[kz];
    float sz = invd;//1.0f / r.d[kz];

    // 3. Translate vertices relative to ray origin and shear them
    vec3 p0 = v0 - r.o;
    vec3 p1 = v1 - r.o;
    vec3 p2 = v2 - r.o;

    float p0x = p0[kx] - sx * p0[kz];
    float p0y = p0[ky] - sy * p0[kz];
    float p1x = p1[kx] - sx * p1[kz];
    float p1y = p1[ky] - sy * p1[kz];
    float p2x = p2[kx] - sx * p2[kz];
    float p2y = p2[ky] - sy * p2[kz];

    // 4. Compute scaled barycentric coordinates (Edge functions in 2D projection)
    float u = p2x * p1y - p2y * p1x;
    float v = p0x * p2y - p0y * p2x;
    float w = p1x * p0y - p1y * p0x;

    // Fallback for edge cases with exact zero on flat/degenerate triangles
    if (u == 0.0f || v == 0.0f || w == 0.0f) {
        double u_db = double(p2x) * double(p1y) - double(p2y) * double(p1x);
        double v_db = double(p0x) * double(p2y) - double(p0y) * double(p2x);
        double w_db = double(p1x) * double(p0y) - double(p1y) * double(p0x);
        u = float(u_db); v = float(v_db); w = float(w_db);
    }

    // 5. Perform early rejection check on signs
    if ((u < 0.0f || v < 0.0f || w < 0.0f) && (u > 0.0f || v > 0.0f || w > 0.0f)) {
        return false;
    }

    // Calculate determinant for normalization
    float det = u + v + w;
    if (det == 0.0f) return false;
    float inv_det = 1.0f / det;
    // 6. Compute tHit distance and validate depth bounds
    float p0z = p0[kz] * sz;
    float p1z = p1[kz] * sz;
    float p2z = p2[kz] * sz;
    float tHit = (u * p0z + v * p1z + w * p2z) * inv_det;

    if (tHit < 0.0001f || tHit >= t) return false;

    // 7. Ray intersects triangle successfully. Normalize barycentric coordinates
    
    t = tHit;
    rec.u = u * inv_det;
    rec.v = v * inv_det;
    rec.triangle_ind = i;
    rec.mtl_ind = triIndex.w;

    return true;
}
