float hit_bbox_integrated(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, out float tl)
{
    bvec3 is_pos = greaterThanEqual(invdir, vec3(0.0));

    vec3 boxMin = mix(bmax, bmin, is_pos); 
    vec3 boxMax = mix(bmin, bmax, is_pos);

    vec3 tmin3 = (boxMin - r.o) * invdir;
    vec3 tmax3 = (boxMax - r.o) * invdir;
  
    tl = max(max(tmin3.x, tmin3.y), tmin3.z);
    float th = min(min(tmax3.x, tmax3.y), tmax3.z);
    
    // Ép ?i?u ki?n h?p l? vào ?ây:
    // 1. tl <= th: Tia ph?i c?t qua Box
    // 2. th >= 0.0f: Box ph?i n?m tr??c m?t Camera (không n?m sau l?ng)
    if (tl > th || th < 0.0f) 
    {
        tl = 1e30f; // N?u tr??t, gán tl b?ng vô cùng
    }

    return tl; 
}

