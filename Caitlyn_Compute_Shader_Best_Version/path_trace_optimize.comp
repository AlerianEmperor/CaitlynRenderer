            int start = int(bmin.w);
            int end   = start + range;
            for (int i = end - 1; i >= start; --i) 
            {
                if (hitTriangleNoRec(r, i, max_t)) return true;
            }
        }   
        
        // Pop ph?n t? ti?p theo t? stack
        ind = (ptr > 0) ? stk[--ptr] : -1;
    }
    return false;
}

vec3 sample_light_position(int li)
{
    Light4 l = lights[li];
    vec3 p = l.p.xyz;
    vec3 u = l.u.xyz;
    vec3 v = l.v.xyz;
    float s = sqrt(rand());
    float b0 = 1.0f - s;
    float b1 = rand() * s;
    return p + b0 * u + b1 * v;
}

vec3 path_trace(inout Ray r)
{
	vec3 L = vec3(0.0f);
	vec3 T = vec3(1.0f);

	float prev_pdf = 1.0f;


	//Ray new_ray = r;
	bool is_specular = true;

	for(int i = 0; i < 3; ++i)
	{
        if (i >= 1)
	    {
	        // Max throughput component determines survival probability
			float p = max(T.x, max(T.y, T.z));
			
			// Cap the survival probability to prevent infinite energy variance
			if (p > 0.95f) p = 0.95f; 

			// Use your rand() function to evaluate Russian Roulette condition
			if (rand() > p)
			{
		        break; // Terminate the ray path early
			}

			// Unbias the throughput vector with the survival probability
			T /= p; 
		}
		HitRecord rec;
		
        //if(trace_bvh_adjacent(r, rec))
		if(trace_bvh_dfs(r, rec))
        //fail
        //if(trace_bvh_stackless(r, rec))
		{
			float cos_incident = dot(r.d, rec.n);

			vec3 original_n = rec.n;

			if (cos_incident > 0)
				rec.n = -rec.n;

			vec4 emission = rec.emission;

			if(emission.w != -1)
			{
				if(!is_specular)
				{
					vec3 light_direction = r.d * rec.t;

					float length = length(light_direction);

					light_direction = normalize(light_direction);

					float cos_light = (-dot(light_direction, rec.n));//ko can abs

					float length2 = length * length;

					int light_index = int(emission.w);//int(vt.w);

					
					Light4 l = lights[light_index];
					vec3 light_area_pdf = l.area_pdf.xyz;
					
                   
					//vec3 light_area_pdf = lights[light_index].area_pdf.xyz;

					float pdf_light = length2 / (light_area_pdf.x * cos_light) * light_area_pdf.y;
					float mis_weight = power_heuristic(prev_pdf, pdf_light);

					
					L += T * emission.xyz * mis_weight;

					return L;
				}
                else
				{
					L += T * emission.xyz;
					return L;
				}
			}

			vec3 hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

            vec4 specular = rec.specular;

			if(specular.w == 0)
			{
				int light_index = int(rand() * numLights);
				
				vec3 light_position = sample_light_position(light_index);

				vec3 light_direction = light_position - hit_point;

				float length = length(light_direction);

				float ilength = 1.0f / length;

				light_direction *= ilength;

				float cos_mtl = dot(light_direction, original_n);

				//float cos_light = dot(light_direction, rec.n);

				Ray light_ray = Ray(hit_point, light_direction);

                //Ray light_ray = Ray(light_position, -light_direction);

				Light4 l = lights[light_index];

				vec3 light_normal = l.n.xyz;
				
				float cos_light = ((dot(light_direction, light_normal)));

                //if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_adjacent(light_ray, length))
                if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_dfs(light_ray, length))		
                //fail
                //if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_stackless(light_ray, length))		
				{	
					//Light4 l = lights[light_index];
					
					vec3 light_emission = l.e.xyz;
					
					vec3 light_area_pdf = l.area_pdf.xyz;
					
					float pdf_light = (length * length) / (light_area_pdf.x * -cos_light) * light_area_pdf.y;

					vec3 bsdf_eval = diffuse_bsdf(r, rec, light_direction);

					float bsdf_pdf = diffuse_pdf(r, rec, light_direction);

					float mis_weight = power_heuristic(pdf_light, bsdf_pdf);

					L += T * light_emission * bsdf_eval * mis_weight / pdf_light;
					
				}
			}

			//Sample for new ray
			vec3 sample_direction = diffuse_sample(r, rec.n);
			vec3 new_hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

			vec3 sample_eval = diffuse_bsdf(r, rec, sample_direction);

			float bsdf_pdf = diffuse_pdf(r, rec, sample_direction);

            //no russian roulette
			T *= sample_eval;

            float energy = max(T.x, max(T.y, T.z));
            if (energy < 0.01f) 
            {
                break; 
            }
               

			prev_pdf = bsdf_pdf;

			is_specular = false;

			r.o = new_hit_point;
			r.d = sample_direction;

			//r = Ray(new_hit_point, sample_direction);
		}
		else
			return L;
	}
	return L;
}


vec3 path_trace_probability(inout Ray r)//, float branch_probability)
{
	vec3 L = vec3(0.0f);
	vec3 T = vec3(1.0f);

	float prev_pdf = 1.0f;
	bool is_specular = true;

	// Thi?t l?p t? l? ph?n tr?m l?a ch?n (Ví d?: 0.5 ngh?a là 50% Direct / 50% Indirect)
	// B?n có th? tùy ch?nh bi?n này (0.3 ngh?a là 30% Direct / 70% Indirect)
	//const float branch_probability = 0.5f; 

    float branch_probability = 0.8;
	for(int i = 0; i < 3; ++i)
	{
        //float branch_probability = (i == 0) ? 0.90f : 0.25f; 
		if (i >= 1)
		{
			// Gi? nguyên Russian Roulette t?ng c?a b?n ?? ch?n tia y?u
			float p = max(T.x, max(T.y, T.z));
			if (p > 0.95f) p = 0.95f; 
			if (rand() > p) break; 
			T /= p; 
		}
		HitRecord rec;
		
		if(trace_bvh_dfs(r, rec))
		{
			float cos_incident = dot(r.d, rec.n);
			vec3 original_n = rec.n;

			if (cos_incident > 0)
				rec.n = -rec.n;

			vec4 emission = rec.emission;

			if(emission.w != -1)
			{
				if(is_specular)
				{
					L += T * emission.xyz;
					return L;
				}
				else
				{
					vec3 light_direction = r.d * rec.t;
					float length = length(light_direction);
					light_direction = normalize(light_direction);

					float cos_light = (-dot(light_direction, rec.n));
					float length2 = length * length;
					int light_index = int(emission.w);
					
					Light4 l = lights[light_index];
					vec3 light_area_pdf = l.area_pdf.xyz;

					float pdf_light = length2 / (light_area_pdf.x * cos_light) * light_area_pdf.y;
					float mis_weight = power_heuristic(prev_pdf, pdf_light);
					
					L += T * emission.xyz * mis_weight;
					return L;
				}
			}

			vec3 hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;
			vec4 specular = rec.specular;

			// ============================================================
			// TRÒ CH?I MAY R?I NGA: CH?N ???NG DIRECT HO?C INDIRECT
			// ============================================================
			float roulette_dice = rand();

			if (specular.w == 0 && roulette_dice < branch_probability)
			{
				// ??? NHÁNH 1: CH? TÍNH DIRECT LIGHTING (B?N TIA SHADOW) ???
				
				// Nhân bù n?ng l??ng cho nhánh này vì ?ã gánh ph?n c?a các tia b? tri?t tiêu
				vec3 branch_T = T / branch_probability; 

				int light_index = int(rand() * numLights);
				vec3 light_position = sample_light_position(light_index);
				vec3 light_direction = light_position - hit_point;
				float length = length(light_direction);
				float ilength = 1.0f / length;
				light_direction *= ilength;

				float cos_mtl = dot(light_direction, original_n);
				Ray light_ray = Ray(hit_point, light_direction);

				Light4 l = lights[light_index];
				vec3 light_normal = l.n.xyz;
				float cos_light = ((dot(light_direction, light_normal)));

				if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_dfs(light_ray, length))		
				{	
					vec3 light_emission = l.e.xyz;
					vec3 light_area_pdf = l.area_pdf.xyz;
					float pdf_light = (length * length) / (light_area_pdf.x * -cos_light) * light_area_pdf.y;

					vec3 bsdf_eval = diffuse_bsdf(r, rec, light_direction);
					float bsdf_pdf = diffuse_pdf(r, rec, light_direction);
					float mis_weight = power_heuristic(pdf_light, bsdf_pdf);

					L += branch_T * light_emission * bsdf_eval * mis_weight / pdf_light;
				}

				// Vì ?ã ch?n Direct Lighting, ta d?ng luôn ???ng ?i c?a tia, không n?y ti?p n?a!
				break; 
			}
			else
			{
				// ??? NHÁNH 2: B? QUA TIA SHADOW, CH? B?N TIA GIÁN TI?P N?Y TI?P ???
				
				// Nhân bù n?ng l??ng cho nhánh n?y ti?p
				T /= (1.0f - branch_probability); 

				// Th?c hi?n l?y m?u cho tia ti?p theo nh? bình th??ng
				vec3 sample_direction = diffuse_sample(r, rec.n);
				vec3 new_hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

				vec3 sample_eval = diffuse_bsdf(r, rec, sample_direction);
				float bsdf_pdf = diffuse_pdf(r, rec, sample_direction);

				T *= sample_eval;

				float energy = max(T.x, max(T.y, T.z));
				if (energy < 0.01f) break; 

				prev_pdf = bsdf_pdf;
				is_specular = false;

				r.o = new_hit_point;
				r.d = sample_direction;

                // diffuse_eval là màu s?c c?a ch?t li?u (ví d?: rec.color)
                float material_brightness = max(sample_eval.x, max(sample_eval.y, sample_eval.z));

                // V?t th? càng sáng thì càng ?u tiên ?i ti?p (Indirect), gi?m t? l? d?ng l?i làm Direct
                branch_probability = clamp(1.0f - material_brightness, 0.2f, 0.8f);
			}
			// ============================================================
		}
		else
			return L;
	}
	return L;
}

