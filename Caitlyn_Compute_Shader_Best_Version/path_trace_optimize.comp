    // Áp d?ng kho?ng d?ch vào t?a ?? UV g?c
    vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f) + vec2(jitter_offset_x, jitter_offset_y)) / screenResolution;
    seed = texCoords;

    float r1 = 2.0f * rand();
