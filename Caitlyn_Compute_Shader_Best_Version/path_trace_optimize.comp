float hit_bbox(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, out float tl)
{
    
    float t1x = (invdir.x >= 0.0) ? bmin.x : bmax.x;
    float t2x = (invdir.x >= 0.0) ? bmax.x : bmin.x;
    float tmin_x = (t1x - r.o.x) * invdir.x;
    float tmax_x = (t2x - r.o.x) * invdir.x;

    float t1y = (invdir.y >= 0.0) ? bmin.y : bmax.y;
    float t2y = (invdir.y >= 0.0) ? bmax.y : bmin.y;
    float tmin_y = (t1y - r.o.y) * invdir.y;
    float tmax_y = (t2y - r.o.y) * invdir.y;

    float t1z = (invdir.z >= 0.0) ? bmin.z : bmax.z;
    float t2z = (invdir.z >= 0.0) ? bmax.z : bmin.z;
    float tmin_z = (t1z - r.o.z) * invdir.z;
    float tmax_z = (t2z - r.o.z) * invdir.z;

   tl = max(tmin_x, max(tmin_y, tmin_z));
    float th = min(tmax_x, min(tmax_y, tmax_z));
    
    return th; 
}

