// Sobol 2D x?p x? nhanh cho GPU
vec2 sobol2D(uint index) 
{
    uint x = 0u;
    uint y = 0u;
    
    // Ma tr?n h??ng Sobol rút g?n cho 16-bit
    uint m1 = 0x9c4912d3u;
    uint m2 = 0x4fc3a51du;

    for (uint b = 0u; index > 0u; index >>= 1u, b++) 
    {
        if ((index & 1u) != 0u) 
        {
            x ^= (m1 >> b);
            y ^= (m2 >> b);
        }
    }
    return vec2(float(x & 0xFFFFu) / 65536.0f, float(y & 0xFFFFu) / 65536.0f);
}

