bool trace_bvh_adjacent(Ray r, out HitRecord rec)
{
    int stk[32]; 
    int ptr = 0;
    float t = inf;
    const vec3 invdir = 1.0f / (r.d);

    int ind = 0; // Nút g?c (Root) luôn b?t ??u t?i index 0
    
    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w); // range > 0 là nút lá, range == 0 là nút trong

        if (range == 0) 
        {
            // C?u trúc m?i: nút cha ch? l?u v? trí c?a con trái
            int leftIndex  = int(bmin.w); 
            int rightIndex = leftIndex + 1; // Con ph?i luôn k? sát con trái
            
            float tl1, th1, tl2, th2;
            
            // ??c d? li?u AABB c?a 2 nút con t? m?ng bvh
            // Do 2 con n?m k? nhau, vi?c n?p d? li?u vào Cache c?a GPU s? di?n ra c?c nhanh
            th1 = hit_bbox4(r, bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz, invdir, tl1);
            th2 = hit_bbox4(r, bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz, invdir, tl2);

            // Ki?m tra giao c?t
            bool left  = (tl1 <= th1) && (th1 > 0.0f) && (tl1 < t);
            bool right = (tl2 <= th2) && (th2 > 0.0f) && (tl2 < t);

            if (left && right)
            {
                // Thu?t toán "Chung": ?u tiên duy?t nhánh g?n tia h?n (tl1 và tl2 quy?t ??nh)
                // Nhánh xa h?n ???c ??y vào Stack ?? quay l?i x? lý sau
                if (tl1 < tl2) 
                { 
                    stk[ptr++] = rightIndex; 
                    ind = leftIndex; 
                }
                else 
                { 
                    stk[ptr++] = leftIndex; 
                    ind = rightIndex; 
                }
                continue;
            }
            else if (left)  { ind = leftIndex;  continue; }
            else if (right) { ind = rightIndex; continue; }
        }   
        else 
        {
            // X? lý nút lá: duy?t các tam giác n?m trong nút lá này
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = end - 1; i >= start; --i) 
            { 
                hit_triangle2(r, i, rec, t); 
            }
        }
        
        // L?y nút ti?p theo t? Stack ra n?u không giao c?t ho?c v?a x? lý xong nút lá
        ind = (ptr > 0) ? stk[--ptr] : -1;
    }
    
    // Ghi nh?n k?t qu? va ch?m g?n nh?t
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

