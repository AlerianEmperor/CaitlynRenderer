    // D?ch tâm tia m?t kho?ng siêu nh? tùy theo Frame ch?n/l? ?? kh? r?ng c?a vi?n
    float jitter_offset_x = (currentFrameSample % 2 == 0) ? 0.25f : -0.25f;
