    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        // 1. L?y m?c tiêu nh?y skip n?u TR??T (luôn n?m ? bmin.w cho c? nút trong và nút lá)
        int skip_index = int(bmin.w); 

        // 2. Ki?m tra giao c?t h?p nút hi?n t?i
        float tl, th;
        th = hit_bbox4(r, bmin.xyz, bmax.xyz, invdir, tl);
        
        // ?i?u ki?n trúng: t_kéo_dài <= t_thu_h?p, h?p n?m phía tr??c tia, và kho?ng cách h?p nh? h?n t_g?n_nh?t hi?n t?i
        bool hit = (tl <= th) && (th > 0.0f) && (tl < t);

        if (hit)
        {
            if (range == 0) 
            {
                // NÚT TRONG: Trúng h?p thì ti?n th?ng vào con bên trái (luôn là v? trí k? ti?p trong m?ng DFS)
                ind = ind + 1;
            }   
            else 
            {
                // NÚT LÁ: Duy?t danh sách tam giác
                int start = int(bmin.w);//start_index_t?_bút_ph?ng_c?a_b?n; // Thay b?ng cách b?n l?y tr??ng start (ví d? l?y t? c?u trúc SoA ho?c bmin.w tùy cách b?n n?p)
                int end   = start + range;
                
                for (int i = start; i < end; ++i) 
                { 
                    hit_triangle2(r, i, rec, t); 
                }
                
                // QUAN TR?NG: Duy?t xong nút lá (dù trúng hay tr??t tam giác), 
                // tia v?n ph?i ?i ti?p sang nút không gian ngay sát c?nh nó theo chu?i DFS
                ind = ind + 1; 
            }
        }
        else
        {
            // TR??T H?P: Nh?y th?n t?c qua skip_index ???c CPU tính s?n ?? b? qua c? c?m cây con
            ind = skip_index;
        }
    }
    
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

