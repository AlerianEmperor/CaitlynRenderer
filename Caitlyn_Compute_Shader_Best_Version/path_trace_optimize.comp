    jitter /= (screenResolution * 0.5f);

    vec2 d = (2.0f * texCoords - 1.0f) + jitter;

    float tan_fov = tan(camera.fov * 0.5f);
    d.x *= screenResolution.x / screenResolution.y * tan_fov;
    d.y *= tan_fov;

    vec3 rayDir = normalize(d.x * camera.right + d.y * camera.up + camera.forward);
    Ray ray = Ray(camera.position, rayDir);

    // 2. ??c màu l?y k? c? t? k?t c?u l?u tr? (Texture)
    vec3 accumulate_color = texture(accumulate_tex, (vec2(pixelCoords) + vec2(0.5f)) / screenResolution).xyz;

