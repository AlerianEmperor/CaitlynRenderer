float hit_bbox_center_extent(Ray r, vec3 center, vec3 extent, vec3 invdir, out float tl)
{
    // Tính kho?ng cách t? tâm h?p ??n g?c tia theo t?ng tr?c
    vec3 v = center - r.o;
    
    // T?n d?ng l?nh ph?n c?ng 'abs' và toán h?c tích ch?p ?? tìm kho?ng cách giao c?t
    vec3 t_center = v * invdir;
    vec3 t_extent = extent * abs(invdir);
    
    vec3 t_min = t_center - t_extent;
    vec3 t_max = t_center + t_extent;
    
    // Tìm kho?ng cách ?i vào (tl) và ?i ra (th) l?n nh?t/nh? nh?t gi?a các tr?c
    tl = max(max(t_min.x, t_min.y), t_min.z);
    float th = min(min(t_max.x, t_max.y), t_max.z);
    
    return th;
}

float power_heuristic(float a, float b)
{
    float t = a * a;
    return t / (b * b + t);
}

