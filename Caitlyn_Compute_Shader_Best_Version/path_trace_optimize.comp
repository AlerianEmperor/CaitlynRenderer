        float l_up    = dot(c_up,    vec3(0.2126, 0.7152, 0.0722));
        float l_down  = dot(c_down,  vec3(0.2126, 0.7152, 0.0722));
        float l_left  = dot(c_left,  vec3(0.2126, 0.7152, 0.0722));
        float l_right = dot(c_right, vec3(0.2126, 0.7152, 0.0722));
        
        float l_center = (l_up + l_down + l_left + l_right) * 0.25f;
        
        float w_up    = exp(-abs(l_up - l_center) * 4.0f);
        float w_down  = exp(-abs(l_down - l_center) * 4.0f);
        float w_left  = exp(-abs(l_left - l_center) * 4.0f);
        float w_right = exp(-abs(l_right - l_center) * 4.0f);
        
        float total_weight = w_up + w_down + w_left + w_right;
        
        vec3 final_color;
        if (total_weight > 0.01f) {
            final_color = (c_up * w_up + c_down * w_down + c_left * w_left + c_right * w_right) / total_weight;
        } else {
            final_color = (c_up + c_down + c_left + c_right) * 0.25f;
        }
        
        imageStore(img_output, pixelCoords, vec4(final_color, 1.0f));
    }
}

void main_checker3()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(screenResolution.x) || pixelCoords.y >= int(screenResolution.y)) 
    {
        return;
    }

    bool is_even_pixel = ((pixelCoords.x + pixelCoords.y) % 2 == 0);
    bool should_trace = (currentFrameSample % 2 == 0) ? is_even_pixel : !is_even_pixel;

    vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f)) / screenResolution;

    if (should_trace)
    {
        seed = texCoords;

        float r1 = 2.0f * rand();
        float r2 = 2.0f * rand();

        vec2 jitter;
        jitter.x = r1 < 1.0 ? sqrt(r1) - 1.0f : 1.0f - sqrt(2.0f - r1);
        jitter.y = r2 < 1.0 ? sqrt(r2) - 1.0f : 1.0f - sqrt(2.0f - r2);
        jitter /= (screenResolution * 0.5f);

        vec2 d = (2.0f * texCoords - 1.0f) + jitter;

        float tan_fov = tan(camera.fov * 0.5f);
        d.x *= screenResolution.x / screenResolution.y * tan_fov;
        d.y *= tan_fov;

        vec3 rayDir = normalize(d.x * camera.right + d.y * camera.up + camera.forward);
        Ray ray = Ray(camera.position, rayDir);

        vec3 accumulate_color = texture(accumulate_tex, texCoords).xyz;
        vec3 pixelColor = path_trace(ray);

        imageStore(img_output, pixelCoords, vec4(pixelColor + accumulate_color, 1.0f));
    }
    else
    {
        // ??c 4 tr?c k? c?nh
        vec3 c_up    = imageLoad(img_output, pixelCoords + ivec2(0, 1)).xyz;
        vec3 c_down  = imageLoad(img_output, pixelCoords + ivec2(0, -1)).xyz;
        vec3 c_left  = imageLoad(img_output, pixelCoords + ivec2(-1, 0)).xyz;
        vec3 c_right = imageLoad(img_output, pixelCoords + ivec2(1, 0)).xyz;
        
        // N?i suy thô ban ??u
        vec3 soft_color = (c_up + c_down + c_left + c_right) * 0.25f;
        
        // --- THU?T TOÁN SHARPENING KH? NHÒE KHÔNG GIAN (CAS KERNEL) ---
        // Tìm giá tr? ?? sáng c?c ??i và c?c ti?u trong vùng lân c?n
        float l_up    = dot(c_up,    vec3(0.2126, 0.7152, 0.0722));
        float l_down  = dot(c_down,  vec3(0.2126, 0.7152, 0.0722));
        float l_left  = dot(c_left,  vec3(0.2126, 0.7152, 0.0722));
        float l_right = dot(c_right, vec3(0.2126, 0.7152, 0.0722));
        
        float mn = min(min(l_up, l_down), min(l_left, l_right));
        float mx = max(max(l_up, l_down), max(l_left, l_right));
        
        // Tính toán c??ng ?? s?c nét d?a trên c?u trúc t??ng ph?n vùng biên
        float sharp_intensity = -1.0f / (mix(8.0f, 5.0f, clamp(mx - mn, 0.0f, 1.0f)));
        
        // Ép ng??c ma tr?n ?? làm g?t ???ng vi?n, tri?t tiêu hi?n t??ng m? ??c do blur
        vec3 sharp_color = soft_color + (c_up + c_down + c_left + c_right - 4.0f * soft_color) * sharp_intensity;
        
        // Ch?n tràn ng??ng n?ng l??ng ánh sáng
        vec3 final_color = max(vec3(0.0f), sharp_color);
        
        imageStore(img_output, pixelCoords, vec4(final_color, 1.0f));
    }
}

void main_mo()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(screenResolution.x) || pixelCoords.y >= int(screenResolution.y)) 
    {
        return;
    }

    // 1. T?o Jitter ?an xen ??ng theo th?i gian (Temporal Anti-Aliasing Jitter)
    // Giúp kh? r?ng c?a thô mà không làm nhòe c?u trúc kh?i v?t th?
    float jitter_offset_x = (currentFrameSample % 2 == 0) ? 0.25f : -0.25f;
    float jitter_offset_y = ((currentFrameSample / 2) % 2 == 0) ? 0.25f : -0.25f;

    vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f) + vec2(jitter_offset_x, jitter_offset_y)) / screenResolution;
	
    seed = texCoords;

    float r1 = 2.0f * rand();
    float r2 = 2.0f * rand();

    vec2 jitter;
    jitter.x = r1 < 1.0 ? sqrt(r1) - 1.0f : 1.0f - sqrt(2.0f - r1);
    jitter.y = r2 < 1.0 ? sqrt(r2) - 1.0f : 1.0f - sqrt(2.0f - r2);
    jitter /= (screenResolution * 0.5f);

    vec2 d = (2.0f * texCoords - 1.0f) + jitter;

    float tan_fov = tan(camera.fov * 0.5f);
    d.x *= screenResolution.x / screenResolution.y * tan_fov;
    d.y *= tan_fov;

    vec3 rayDir = normalize(d.x * camera.right + d.y * camera.up + camera.forward);
    Ray ray = Ray(camera.position, rayDir);

    // 2. Ch?y Path Tracing g?c cho TOÀN B? pixel (?n kh?p 100% ph?n c?ng)
    vec3 pixelColor = path_trace(ray);

    // 3. ??c d? li?u tích l?y t? k?t c?u khung hình c?
    vec3 accumulate_color = texture(accumulate_tex, (vec2(pixelCoords) + vec2(0.5f)) / screenResolution).xyz;

    // 4. C? ch? Exponential Moving Average (EMA) giúp ?nh m?n siêu t?c 
    // T?c ?? h?i t? t?ng v?t mà ???ng biên v?t th? s?c l?m, không b? lem màu pixel lân c?n
    float alpha = 1.0f / float(currentFrameSample + 1);
    vec3 final_blend = mix(accumulate_color, pixelColor, alpha);

    imageStore(img_output, pixelCoords, vec4(final_blend, 1.0f));
}

void main_final()
