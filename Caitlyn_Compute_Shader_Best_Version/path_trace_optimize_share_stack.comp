float rand()
{
    seed -= vec2(randomVector.x * randomVector.y);
    uint state = floatBitsToUint(seed.x * 1234567.0 + seed.y * 7654321.0);
    return fract(sin(dot(seed, vec2(12.9898, 78.233))) * 43758.5453);
}

void onb(in vec3 n, out vec3 b1, out vec3 b2)
{
    if (n.z < -0.999f) {
        b1 = vec3(0, -1, 0);
        b2 = vec3(-1, 0, 0);
    } else {
        float a = 1.0 / (1.0 + n.z);
        float b = -n.x * n.y * a;
        b1 = vec3(1.0 + b, b, -n.x);
        b2 = vec3(b, 1.0 + b, -n.y);
    }
}

float hit_bbox7(vec3 o, vec3 bmin, vec3 bmax, vec3 invdir, out float tl)
{
    bvec3 is_pos = greaterThanEqual(invdir, vec3(0.0));

    vec3 t1 = mix(bmax, bmin, is_pos); // Trong GLSL m?i, mix v?i bvec3 ho?t ??ng nh? hàm ch?n ph?n c?ng (select)
    vec3 t2 = mix(bmin, bmax, is_pos);

    t1 = (t1 - o) * invdir;
    t2 = (t2 - o) * invdir;

  
    //tl = max(tmin3.x, max(tmin3.y, tmin3.z));
    //float th = min(tmax3.x, min(tmax3.y, tmax3.z));
    
    tl = max(max(t1.x, t1.y), t1.z);
    return min(min(t2.x, t2.y), t2.z);

    //return th; 
}

float power_heuristic(float a, float b)
{
    float t = a * a;
    return t / (b * b + t);
}

struct HitRecord
{
    vec4 albedo;  
    vec4 emission;
    vec4 specular;
    vec4 tex_ind;
    vec3 n;
    vec2 texcoord;
    float u;
    float v;
    float t;
    int triangle_ind;
    int mtl_ind;
};

vec3 cosine_hemisphere_sampling()
{
    float u1 = rand();
    float u2 = rand();
    float r = sqrt(u1);
    float phi = pi2 * u2;
    return vec3(r * cos(phi), r * sin(phi), sqrt(1.0f - u1));
}

vec3 diffuse_sample(in Ray r, vec3 n)
{
    vec3 u, v;
    onb(n, u, v);
    vec3 dir = cosine_hemisphere_sampling();
    dir = u * dir.x + v * dir.y + n * dir.z;
    return dir;
}

float diffuse_pdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    float cos = dot(sample_direction, rec.n);
    return cos * ipi;
}

vec3 diffuse_bsdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    return rec.albedo.xyz;
} 

vec2 interpolate(vec2 a, vec2 b, vec2 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }
vec3 interpolate(vec3 a, vec3 b, vec3 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }

bool hit_triangle(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    vec3 tv = r.o - v0;
    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    vec4 uvt;
    uvt.x = dot(tv, pv);
    uvt.y = dot(r.d, qv);
    uvt.z = dot(v2, qv);
    float inv_det = 1.0f / dot(v1, pv);

    uvt.xyz = uvt.xyz * inv_det;
    uvt.w = 1.0 - uvt.x - uvt.y;
    
    if (all(greaterThanEqual(uvt, vec4(0.0f))) && uvt.z < t)
    {
        t = uvt.z;
        rec.u = uvt.x;
        rec.v = uvt.y;
        rec.triangle_ind = i;
        rec.mtl_ind = (triIndex.w);
        return true;
    }   
    return false;
}

bool hit_triangle2(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = cross(r.d, v2);
    float det = dot(v1, pv);

    if (abs(det) < 1e-6) return false;
    float inv_det = 1.0f / det;

   vec3 tv = r.o - v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qv = cross(tv, v1);
    float v = dot(r.d, qv) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;

   float t_hit = dot(v2, qv) * inv_det;
    
    if (t_hit > 0.0 && t_hit < t)
    {
        t = t_hit;
        rec.u = u;
        rec.v = v;
        rec.triangle_ind = i;
        rec.mtl_ind = triIndex.w;
        return true;
    }   
    return false;
}

//best
bool hitTriangleNoRec(in Ray r, int i, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz;
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    float det = v1.x * pv.x + v1.y * pv.y + v1.z * pv.z;
    if (det == 0.0) return false;

    float inv_det = 1.0 / det;
    vec3 tv = r.o - v0;

    float u = (tv.x * pv.x + tv.y * pv.y + tv.z * pv.z) * inv_det;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    float v = (r.d.x * qv.x + r.d.y * qv.y + r.d.z * qv.z) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;

    float tHit = (v2.x * qv.x + v2.y * qv.y + v2.z * qv.z) * inv_det;
    if (tHit <= 0.0 || tHit >= t) return false;

    return true;
}


void compute_normal_texcoord_and_material(inout HitRecord rec)
{
    int triangle_ind = rec.triangle_ind;
    int mtl_ind = (rec.mtl_ind);
    ivec4 vn = triangles[3 * triangle_ind + 1];
    
    if (vn.w == 0)
        rec.n = vn.xyz;
    else
    {
        vec3 vn0 = normals[vn.x].xyz;
        vec3 vn1 = normals[vn.y].xyz;
        vec3 vn2 = normals[vn.z].xyz;
        rec.n = interpolate(vn0, vn1, vn2, rec.u, rec.v);
    }
    
    rec.tex_ind = materials[4 * mtl_ind + 3];
    rec.emission = materials[4 * mtl_ind + 1];
    rec.specular = materials[4 * mtl_ind + 2];

    if (rec.tex_ind.x != -1)
    {
        ivec4 vt = triangles[3 * triangle_ind + 2];
        vec2 vt0 = texcoords[vt.x].xy;
        vec2 vt1 = texcoords[vt.y].xy;
        vec2 vt2 = texcoords[vt.z].xy;
        rec.texcoord = interpolate(vt0, vt1, vt2, rec.u, rec.v);
        rec.albedo = texture(albedo_textures, vec3(rec.texcoord, rec.tex_ind.x));
    }
    else
        rec.albedo = materials[4 * mtl_ind];
}

shared int shared_stk[64][32];

bool trace_bvh_dfs_share_stack(Ray r, out HitRecord rec)
{
    uint thread_idx = gl_LocalInvocationIndex; 

    int ptr = 0;
    float t = inf;
    const vec3 invdir = 1.0f / (r.d);
    const vec3 o = r.o;
   
    int ind = 0;
    
    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        if (range == 0) 
        {
            int leftIndex  = ind + 1; 
            int rightIndex = int(bmin.w); 
            float tl1, th1, tl2, th2;
            th1 = hit_bbox7(o, bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz, invdir, tl1);
            th2 = hit_bbox7(o, bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz, invdir, tl2);

            bool left  = (tl1 <= th1) && (th1 > 0.0f) && (tl1 < t);
            bool right = (tl2 <= th2) && (th2 > 0.0f) && (tl2 < t);

            //bool left  = max(tl1, 0.0f) <= min(th1, t);
            //bool right = max(tl2, 0.0f) <= min(th2, t);

            if (left && right)
            {
                //if (tl1 < tl2) { stk[ptr++] = rightIndex; ind = leftIndex; }
                //else { stk[ptr++] = leftIndex; ind = rightIndex; }
                //continue;

                //int closer_node = (tl1 < tl2) ? leftIndex  : rightIndex;
                //int farther_node = (tl1 < tl2) ? rightIndex : leftIndex;

                //shared_stk[thread_idx][ptr++] = farther_node; // ??y nút xa vào danh sách ch?
                //ind = closer_node;         // ?u tiên ?i sâu xu?ng nút g?n tr??c

                int near_node = (tl1 < tl2) ? leftIndex  : rightIndex;
                int far_node = (tl1 < tl2) ? rightIndex : leftIndex;

                shared_stk[thread_idx][ptr++] = far_node; // ??y nút xa vào danh sách ch?
                ind = near_node;         // ?u tiên ?i sâu xu?ng nút g?n tr??c
                continue;
            }
            else if (left) { ind = leftIndex; continue; }
            else if (right) { ind = rightIndex; continue; }
            /*else
            {
                ind = (ptr > 0) ? stk[--ptr] : -1; continue;
            }*/
        }   
        else 
        {
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = start; i < end; ++i) { hit_triangle2(r, i, rec, t); }
        }
        ind = (ptr > 0) ? shared_stk[thread_idx][--ptr] : -1;
        /*ind = -1;
        while(ptr > 0)
        {
            int next_ind = stk[--ptr];
            ind = next_ind;
            break;
        }*/
        /*ind = -1;
        while (ptr > 0) 
        {
            ptr--; 
            if (stk_t[ptr] < t) 
            {
                ind = stk[ptr];
                break;
            }
        }*/
    }
    
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

bool hit_shadow_dfs_share_stack(Ray r, float max_t)
{
    uint thread_idx = gl_LocalInvocationIndex;

    int ptr = 0;
    vec3 invdir = 1.0f / r.d;
    const vec3 o = r.o;
   
    int ind = 0;

    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        if (range == 0) 
        {
            int leftIndex  = ind + 1; 
            int rightIndex = int(bmin.w); 
            float tl1, th1, tl2, th2;
            th1 = hit_bbox7(o, bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz,  invdir, tl1);
            th2 = hit_bbox7(o, bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz, invdir, tl2);

            bool left  = (tl1 <= th1) && (th1 > 0.0) && (tl1 < max_t);
            bool right = (tl2 <= th2) && (th2 > 0.0) && (tl2 < max_t);

            //bool left  = (tl1 <= th1) && (th1 > 0.0f) && (tl1 < max_t) && (th1 <= max_t);
            //bool right = (tl2 <= th2) && (th2 > 0.0f) && (tl2 < max_t) && (th2 <= max_t);

            //bool left  = max(tl1, 0.0001f) <= min(th1, max_t);
            //bool right = max(tl2, 0.0001f) <= min(th2, max_t);

            if (left && right) 
            { 
                //stk[ptr++] = rightIndex; 
                //ind = leftIndex; continue; 

                /*int first  = choose_left ? leftIndex : rightIndex;
                int second = choose_left ? rightIndex : leftIndex;

                stk[ptr++] = second; 
                ind = first; 
                continue;*/

                int first = (tl1 < tl2) ? leftIndex  : rightIndex;
                int second = (tl1 < tl2) ? rightIndex : leftIndex;

                shared_stk[thread_idx][ptr++] = second; // ??y nút xa vào danh sách ch?
                ind = first;         // ?u tiên ?i sâu xu?ng nút g?n tr??c
                continue;
            }
            else if (left) { ind = leftIndex; continue; }
            else if (right) { ind = rightIndex; continue; }
        }
        else 
        {
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = start; i < end; ++i) 
            {
                if (hitTriangleNoRec(r, i, max_t)) return true;
            }
        }   
        ind = (ptr > 0) ? shared_stk[thread_idx][--ptr] : -1;
    }
    return false;
}



vec3 sample_light_position(int li)
{
    Light4 l = lights[li];
    vec3 p = l.p.xyz;
    vec3 u = l.u.xyz;
    vec3 v = l.v.xyz;
    float s = sqrt(rand());
    float b0 = 1.0f - s;
    float b1 = rand() * s;
    return p + b0 * u + b1 * v;
}

vec3 path_trace(inout Ray r)
{
	vec3 L = vec3(0.0f);
	vec3 T = vec3(1.0f);

	float prev_pdf = 1.0f;


	//Ray new_ray = r;
	bool is_specular = true;

	for(int i = 0; i < 3; ++i)
	{
        if (i > 1)
	    {
	        // Max throughput component determines survival probability
			float p = max(T.x, max(T.y, T.z));
			
			// Cap the survival probability to prevent infinite energy variance
			if (p > 0.95f) p = 0.95f; 

			// Use your rand() function to evaluate Russian Roulette condition
			if (rand() > p)
			{
		        break; // Terminate the ray path early
			}

			// Unbias the throughput vector with the survival probability
			T /= p; 
		}
		HitRecord rec;
		if(trace_bvh_dfs_share_stack(r, rec))
        //if(trace_bvh_bitstack_pure(r, rec))
		//if(trace_bvh_dfs(r, rec))
        //if(trace_bvh_stackless(r, rec))
		{
			float cos_incident = dot(r.d, rec.n);

			vec3 original_n = rec.n;

			if (cos_incident > 0)
					rec.n = -rec.n;

			vec4 emission = rec.emission;

			if(emission.w != -1)
			{
				if(is_specular)
				{
					L += T * emission.xyz;
					return L;
				}
				else
				{
					vec3 light_direction = r.d * rec.t;

					float length = length(light_direction);

					light_direction = normalize(light_direction);

					float cos_light = (-dot(light_direction, rec.n));//ko can abs

					float length2 = length * length;

					int light_index = int(emission.w);//int(vt.w);

					
					Light4 l = lights[light_index];
					vec3 light_area_pdf = l.area_pdf.xyz;
					
					float pdf_light = length2 / (light_area_pdf.x * cos_light) * light_area_pdf.y;
					float mis_weight = power_heuristic(prev_pdf, pdf_light);

					
					L += T * emission.xyz * mis_weight;

					return L;
				}
			}

			vec3 hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

            vec4 specular = rec.specular;

			if(specular.w == 0)
			{
				int light_index = int(rand() * numLights);
				
				vec3 light_position = sample_light_position(light_index);

				vec3 light_direction = light_position - hit_point;

				float length = length(light_direction);

				float ilength = 1.0f / length;

				light_direction *= ilength;

				float cos_mtl = dot(light_direction, original_n);

				//float cos_light = dot(light_direction, rec.n);

				Ray light_ray = Ray(hit_point, light_direction);

				Light4 l = lights[light_index];

				vec3 light_normal = l.n.xyz;
				
				float cos_light = ((dot(light_direction, light_normal)));

                if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_dfs_share_stack(light_ray, length))
                //if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_bitstack_pure(light_ray, length))
                //if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_dfs(light_ray, length))
				//if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_stackless(light_ray, length))

                //if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_bitstack(light_ray, length))
                //if(cos_mtl > 0.0f && cos_light < 0.0f && !hit_shadow_bitstack_fixed(light_ray, length))
				{	
					Light4 l = lights[light_index];
					
					vec3 light_emission = l.e.xyz;
					
					vec3 light_area_pdf = l.area_pdf.xyz;
					
					float pdf_light = (length * length) / (light_area_pdf.x * -cos_light) * light_area_pdf.y;

					vec3 bsdf_eval = diffuse_bsdf(r, rec, light_direction);

					float bsdf_pdf = diffuse_pdf(r, rec, light_direction);

					float mis_weight = power_heuristic(pdf_light, bsdf_pdf);

					L += T * light_emission * bsdf_eval * mis_weight / pdf_light;
					
				}
			}

			//Sample for new ray
			vec3 sample_direction = diffuse_sample(r, rec.n);
			vec3 new_hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

			vec3 sample_eval = diffuse_bsdf(r, rec, sample_direction);

			float bsdf_pdf = diffuse_pdf(r, rec, sample_direction);

            //no russian roulette
			T *= sample_eval;

            float energy = max(T.x, max(T.y, T.z));
            if (energy < 0.01f) 
            {
                break; 
            }
               

			prev_pdf = bsdf_pdf;

			is_specular = false;

			r.o = new_hit_point;
			r.d = sample_direction;

			//r = Ray(new_hit_point, sample_direction);
		}
		else
			return L;
	}
	return L;
}

void main()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(screenResolution.x) || pixelCoords.y >= int(screenResolution.y)) 
    {
        return;
    }

    vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f)) / screenResolution;
	
    seed = texCoords;

    //normal
	float r1 = 2.0f * rand();
	float r2 = 2.0f * rand();

    /*uint x = gl_GlobalInvocationID.x;
    uint y = gl_GlobalInvocationID.y;
    
   
    // Initialize deterministic seed per pixel and per frame
    uint seed = x * 1973u + y * 9277u + currentFrameSample * 26699u;

    // Generate non-clumping white noise values between 0.0 and 2.0
    float r1 = 2.0f * pcg_rand(seed);
    float r2 = 2.0f * pcg_rand(seed);*/

	vec2 jitter;

	jitter.x = r1 < 1.0 ? sqrt(r1) - 1.0f : 1.0f - sqrt(2.0f - r1);
	jitter.y = r2 < 1.0 ? sqrt(r2) - 1.0f : 1.0f - sqrt(2.0f - r2);
	jitter /= (screenResolution * 0.5f);

	//vec2 d = (2.0f * tex - 1.0f) + jitter;
    vec2 d = (2.0f * texCoords - 1.0f) + jitter;

	float tan_fov = tan(camera.fov * 0.5f);
	d.x *= tan_fov;//screenResolution.x / screenResolution.y * tan_fov;
	d.y *= tan_fov;

	vec3 rayDir = normalize(d.x * camera.right + d.y * camera.up + camera.forward);

	Ray ray = Ray(camera.position, rayDir);

	vec3 accumulate_color = texture(accumulate_tex, texCoords).xyz;
    //vec3 accumulate_color = imageLoad(img_output, pixelCoords).xyz;


	vec3 pixelColor = path_trace(ray);

	//vec3 pixelColor = vec3(0,1,1);

	//color = pixelColor + accumulate_color;

    imageStore(img_output, pixelCoords, vec4(pixelColor + accumulate_color, 1.0f));

}