#define inf 1e9
#define eps 1e-4f

float rand()
{
    seed -= vec2(randomVector.x * randomVector.y);
    uint state = floatBitsToUint(seed.x * 1234567.0 + seed.y * 7654321.0);
    return fract(sin(dot(seed, vec2(12.9898, 78.233))) * 43758.5453);
}

void onb(in vec3 n, out vec3 b1, out vec3 b2)
{
    if (n.z < -0.999f) {
        b1 = vec3(0, -1, 0);
        b2 = vec3(-1, 0, 0);
    } else {
        float a = 1.0 / (1.0 + n.z);
        float b = -n.x * n.y * a;
        b1 = vec3(1.0 + b, b, -n.x);
        b2 = vec3(b, 1.0 + b, -n.y);
    }
}

struct HitRecord
{
    vec4 albedo;  
    vec4 emission;
    vec4 specular;
    vec4 tex_ind;
    vec3 n;
    vec2 texcoord;
    float u;
    float v;
    float t;
    int triangle_ind;
    int mtl_ind;
};

float power_heuristic(float a, float b)
{
    float t = a * a;
    return t / (b * b + t);
}

float power_heuristic_divide(float a, float b)
{
    return a / (b * b + a * a);
}

vec3 cosine_hemisphere_sampling()
{
    float u1 = rand();
    float u2 = rand();
    float r = sqrt(u1);
    float phi = pi2 * u2;
    return vec3(r * cos(phi), r * sin(phi), sqrt(1.0f - u1));
}

vec3 diffuse_sample(in Ray r, vec3 n)
{
    vec3 u, v;
    onb(n, u, v);
    vec3 dir = cosine_hemisphere_sampling();
    dir = u * dir.x + v * dir.y + n * dir.z;
    return dir;
}

float diffuse_pdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    float cos = dot(sample_direction, rec.n);
    return cos * ipi;
}

vec3 diffuse_bsdf(Ray r, inout HitRecord rec, in vec3 sample_direction)
{
    return rec.albedo.xyz;
} 

vec2 interpolate(vec2 a, vec2 b, vec2 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }
vec3 interpolate(vec3 a, vec3 b, vec3 c, float u, float v) { return a * (1.0f - u - v) + b * u + c * v; }

ivec3 get_ray_sign(vec3 invdir) 
{
    return ivec3(lessThan(invdir, vec3(0.0)));
}

vec4 hit_bbox4_parallel(int node_idx, vec3 r_o, vec3 invdir)
{
    FlatNode4 node = bvh[node_idx];

    // L?p toán vector hóa: x? lý ??ng th?i 4 tr?c X c?a 4 h?p, t??ng t? Y và Z
    vec4 tbot_x = (node.bmin_x - r_o.x) * invdir.x;
    vec4 ttop_x = (node.bmax_x - r_o.x) * invdir.x;
    vec4 tmin_x = min(tbot_x, ttop_x);
    vec4 tmax_x = max(tbot_x, ttop_x);

    vec4 tbot_y = (node.bmin_y - r_o.y) * invdir.y;
    vec4 ttop_y = (node.bmax_y - r_o.y) * invdir.y;
    vec4 tmin_y = min(tbot_y, ttop_y);
    vec4 tmax_y = max(tbot_y, ttop_y);

    vec4 tbot_z = (node.bmin_z - r_o.z) * invdir.z;
    vec4 ttop_z = (node.bmax_z - r_o.z) * invdir.z;
    vec4 tmin_z = min(tbot_z, ttop_z);
    vec4 tmax_z = max(tbot_z, ttop_z);

    // Tìm kho?ng giao c?a c? 4 h?p theo chu?n toán h?c không r? nhánh c? c?a b?n
    vec4 tl = max(tmin_x, max(tmin_y, tmin_z));
    vec4 th = min(tmax_x, min(tmax_y, tmax_z));

    // T?o m?t n? ki?m tra: 
    // 1. tl <= th (Tia c?t qua h?p)
    // 2. th >= 0.0 (H?p n?m phía tr??c tia)
    // 3. node.triangle_count != -1 (H?p con ?ó t?n t?i, không ph?i slot tr?ng)
    //bvec4 hit_mask = lessThanEqual(tl, th) && greaterThanEqual(th, vec4(0.0)) && greaterThanEqual(node.triangle_count, ivec4(0));

    // S?a l?i cú pháp logic bvec4 t?i ?ây
    bvec4 mask1 = lessThanEqual(tl, th);
    bvec4 mask2 = greaterThanEqual(th, vec4(0.0));
    bvec4 mask3 = greaterThanEqual(node.triangle_count, ivec4(0));

    bvec4 hit_mask = bvec4(
        mask1.x && mask2.x && mask3.x,
        mask1.y && mask2.y && mask3.y,
        mask1.z && mask2.z && mask3.z,
        mask1.w && mask2.w && mask3.w
    );

    
    // N?u TRÚNG thì gi? nguyên `tl`, n?u TR??T thì gán b?ng giá tr? vô c?c ?? lúc ??y vào Stack nó t? lo?i
    return mix(vec4(999999.0), tl, hit_mask);
}



bool hit_triangle(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    vec3 tv = r.o - v0;
    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    vec4 uvt;
    uvt.x = dot(tv, pv);
    uvt.y = dot(r.d, qv);
    uvt.z = dot(v2, qv);
    float inv_det = 1.0f / dot(v1, pv);

    uvt.xyz = uvt.xyz * inv_det;
    uvt.w = 1.0 - uvt.x - uvt.y;
    
    if (all(greaterThanEqual(uvt, vec4(0.0f))) && uvt.z < t)
    {
        t = uvt.z;
        rec.u = uvt.x;
        rec.v = uvt.y;
        rec.triangle_ind = i;
        rec.mtl_ind = (triIndex.w);
        return true;
    }   
    return false;
}

bool hit_triangle2(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = -vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz + v0;
    vec3 v2 = vertices[triIndex.z].xyz + v0;

    vec3 pv = cross(r.d, v2);
    float det = dot(v1, pv);

    //front face only
    // if 2 face use abs(det)
    if (abs(det) < 1e-6) return false;
    float inv_det = 1.0f / det;

    vec3 tv = r.o + v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0 ) return false;

    vec3 qv = cross(tv, v1);
    float v = dot(r.d, qv) * inv_det;
    if (v < 0.0 || v > 1.0 || u + v > 1.0) return false;

    float t_hit = dot(v2, qv) * inv_det;
    
    if (t_hit > 0.0 && t_hit < t)
    {
        t = t_hit;
        rec.u = u;
        rec.v = v;
        rec.triangle_ind = i;
        rec.mtl_ind = triIndex.w;
        return true;
    }   
    return false;
}

//best
bool hitTriangleNoRec(in Ray r, int i, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz;
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    //vec3 pv = cross(r.d, v2);

    float det = v1.x * pv.x + v1.y * pv.y + v1.z * pv.z;
    if (abs(det) < 1e-6) return false;
    //if (det == 0.0) return false;

    float inv_det = 1.0 / det;
    vec3 tv = r.o - v0;

    float u = (tv.x * pv.x + tv.y * pv.y + tv.z * pv.z) * inv_det;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    float v = (r.d.x * qv.x + r.d.y * qv.y + r.d.z * qv.z) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;

    float tHit = (v2.x * qv.x + v2.y * qv.y + v2.z * qv.z) * inv_det;
    if (tHit <= 0.0 || tHit >= t) return false;

    return true;
}

void compute_normal_texcoord_and_material(inout HitRecord rec)
{
    int triangle_ind = rec.triangle_ind;
    int mtl_ind = (rec.mtl_ind);
    ivec4 vn = triangles[3 * triangle_ind + 1];
    
    if (vn.w == 0)
        rec.n = vn.xyz;
    else
    {
        vec3 vn0 = normals[vn.x].xyz;
        vec3 vn1 = normals[vn.y].xyz;
        vec3 vn2 = normals[vn.z].xyz;
        rec.n = interpolate(vn0, vn1, vn2, rec.u, rec.v);
    }
    
    rec.tex_ind = materials[4 * mtl_ind + 3];
    rec.emission = materials[4 * mtl_ind + 1];
    rec.specular = materials[4 * mtl_ind + 2];

    if (rec.tex_ind.x != -1)
    {
        ivec4 vt = triangles[3 * triangle_ind + 2];
        vec2 vt0 = texcoords[vt.x].xy;
        vec2 vt1 = texcoords[vt.y].xy;
        vec2 vt2 = texcoords[vt.z].xy;
        rec.texcoord = interpolate(vt0, vt1, vt2, rec.u, rec.v);
        rec.albedo = texture(albedo_textures, vec3(rec.texcoord, rec.tex_ind.x));
    }
    else
        rec.albedo = materials[4 * mtl_ind];
}

