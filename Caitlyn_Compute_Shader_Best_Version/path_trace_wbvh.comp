            } else {
                int start = node.child_or_start.z; 
                int end = start + node.triangle_count.z;
                for (int i = end - 1; i >= start; --i) {
                    if (hitTriangleNoRec(r, i, max_t)) return true;
                }
            }
        }
        // Slot 3
        if (tl_parallel.w < inf) {
            if (node.triangle_count.w == 0) {
                if (ind == -1) 
                ind = node.child_or_start.w; 
                else if (ptr < 64) 
                stk[ptr++] = node.child_or_start.w;
            } else {
                int start = node.child_or_start.w; 
