                }
            }
        }

        // N?u lu?ng chính tr?ng, b?c ph?n t? trong ng?n x?p ra x? lý ti?p
        if (ind == -1 && ptr > 0)
        {
            ind = stk[--ptr];
        }
    }
    return false; 
