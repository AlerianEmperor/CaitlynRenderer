bool trace_bvh_dfs_4way(Ray r, out HitRecord rec)
{
    int stk[64]; // Cây BVH4 nông h?n nh?ng c?n stack an toàn khi r? nhánh nhi?u con
    int ptr = 0;
    float t = inf;
    const vec3 invdir = 1.0f / (r.d);
   
    int ind = 0; // B?t ??u t? nút g?c (Nút s? 0)
    
    while (ind != -1)
    {
        // T?I ?U S?CH S?: N?p nguyên m?t kh?i node struct t? buffer b?ng ID
        FlatNode4 node = bvh[ind];

        ivec4 child_or_start = node.child_or_start;
        ivec4 triangle_count = node.triangle_count;

        // Truy?n th?ng struct node vào hàm song song
        vec4 tl_parallel = hit_bbox4_parallel(node, r.o, invdir);

        // L?c kho?ng cách xa h?n t hi?n t?i
        bvec4 valid_dist_mask = lessThan(tl_parallel, vec4(t));
        tl_parallel = mix(vec4(inf), tl_parallel, valid_dist_mask);

        int hit_nodes[4] = int[](child_or_start.x, child_or_start.y, child_or_start.z, child_or_start.w);
        int hit_counts[4] = int[](triangle_count.x, triangle_count.y, triangle_count.z, triangle_count.w);
        float hit_dists[4] = float[](tl_parallel.x, tl_parallel.y, tl_parallel.z, tl_parallel.w);

        // --- SORT 4 NÚT CON KHÔNG R? NHÁNH B?NG THANH GHI V?I MACRO ---
        /*#define SWAP_NODES(a, b) if (hit_dists[a] > hit_dists[b]) { \
            float t_d = hit_dists[a]; hit_dists[a] = hit_dists[b]; hit_dists[b] = t_d; \
            int t_n = hit_nodes[a]; hit_nodes[a] = hit_nodes[b]; hit_nodes[b] = t_n; \
            int t_c = hit_counts[a]; hit_counts[a] = hit_counts[b]; hit_counts[b] = t_c; \
        }
        SWAP_NODES(0, 1); SWAP_NODES(2, 3);
        SWAP_NODES(0, 2); SWAP_NODES(1, 3);
        SWAP_NODES(1, 2);
        #undef SWAP_NODES*/

        SWAP_NODES(0, 1); SWAP_NODES(2, 3);
        SWAP_NODES(0, 2); SWAP_NODES(1, 3);
        SWAP_NODES(1, 2);

        int next_ind = -1;

        for (int i = 3; i >= 0; --i)
        {
            if (hit_dists[i] >= inf) continue; 

            if (hit_counts[i] == 0) 
            {
                //if (next_ind == -1) next_ind = hit_nodes[i];
                //else stk[ptr++] = hit_nodes[i];
                // NÚT TRONG (Internal Node): 
                if (ind == -1) {
                    ind = hit_nodes[i]; // Gán tr?c ti?p làm m?c tiêu k? ti?p mà không t?n slot Stack
                } else {
                    if (ptr < 64) stk[ptr++] = hit_nodes[i]; // ??y vào Stack an toàn n?u có b?o v? ranh gi?i m?ng
                }
            }   
            else //if (hit_counts[i] > 0)
            {
                int start = hit_nodes[i];
                int end   = start + hit_counts[i];
                for (int tri_idx = end - 1; tri_idx >= start; --tri_idx) 
                { 
                    hit_triangle2(r, tri_idx, rec, t); 
                }
            }
        }
        
        ind = (next_ind != -1) ? next_ind : ((ptr > 0) ? stk[--ptr] : -1);
        /*if (ind == -1 && ptr > 0)
        {
            ind = stk[--ptr];
        }*/
    }
    
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

bool hit_shadow_dfs_4way(Ray r, float max_t)
{
    int stk[64]; // Cây BVH4 nông h?n r?t nhi?u, 64 ph?n t? là an toàn tuy?t ??i
    int ptr = 0;
    vec3 invdir = 1.0f / r.d;

    int ind = 0; // B?t ??u t? nút g?c

    while (ind != -1)
    {
        // T?I ?U S?CH S?: N?p struct t? m?ng 
        FlatNode4 node = bvh[ind];
        ind = -1; // M?c ??nh ng?t n?u l??t này không tìm ???c nút trong m?i

        vec4 tl_parallel = hit_bbox4_parallel(node, r.o, invdir);

        bvec4 valid_shadow_mask = lessThan(tl_parallel, vec4(max_t));
        tl_parallel = mix(vec4(inf), tl_parallel, valid_shadow_mask);
        
        // Slot 0
        if (tl_parallel.x < inf) {
            if (node.triangle_count.x == 0)  {    
                      if (ind == -1) ind = node.child_or_start.x; 
                      else if (ptr < 64) stk[ptr++] = node.child_or_start.x;
            } else { //stk[ptr++] = node.child_or_start.x;
                int start = node.child_or_start.x; int end = start + node.triangle_count.x;
                for (int i = end - 1; i >= start; --i) {
                    if (hitTriangleNoRec(r, i, max_t)) return true; 
                }
            }
        }
        // Slot 1
        if (tl_parallel.y < inf) {
            if (node.triangle_count.y == 0)  {    
            //stk[ptr++] = node.child_or_start.y;
                 if (ind == -1) ind = node.child_or_start.y; 
                 else if (ptr < 64) stk[ptr++] = node.child_or_start.y;
           
            }else {
                int start = node.child_or_start.y; int end = start + node.triangle_count.y;
                for (int i = end - 1; i >= start; --i) {
                    if (hitTriangleNoRec(r, i, max_t)) return true;
                }
            }
        }
        // Slot 2
        if (tl_parallel.z < inf) {
            if (node.triangle_count.z == 0){ 
            //stk[ptr++] = node.child_or_start.z;
                     if (ind == -1) ind = node.child_or_start.z; 
                     else if (ptr < 64) stk[ptr++] = node.child_or_start.z;
           
            }else {
                int start = node.child_or_start.z; int end = start + node.triangle_count.z;
                for (int i = end - 1; i >= start; --i) {
                    if (hitTriangleNoRec(r, i, max_t)) return true;
                }
            }
        }
        // Slot 3
        if (tl_parallel.w < inf) {
            if (node.triangle_count.w == 0){      //stk[ptr++] = node.child_or_start.w;
                 if (ind == -1) ind = node.child_or_start.w; 
                 else if (ptr < 64) stk[ptr++] = node.child_or_start.w;
           
           } else {
                int start = node.child_or_start.w; int end = start + node.triangle_count.w;
                for (int i = end - 1; i >= start; --i) {
                    if (hitTriangleNoRec(r, i, max_t)) return true;
                }
            }
        }

        //ind = (ptr > 0) ? stk[--ptr] : -1;
        if (ind == -1 && ptr > 0)
        {
            ind = stk[--ptr];
        }
       //ind = (next_ind != -1) ? next_ind : ((ptr > 0) ? stk[--ptr] : -1);

    }
    return false; 
}

bool hit_shadow_dfs_4way2(Ray r, float max_t)
{
    int stk[64]; 
    int ptr = 0;
    vec3 invdir = 1.0f / r.d;

    int ind = 0; 

    while (ind != -1)
    {
