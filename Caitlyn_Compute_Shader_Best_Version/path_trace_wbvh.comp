#define pi 3.1415926
#define pi2 6.2831853
#define ipi 1.0f / pi

struct Ray { vec3 o; vec3 d; };
struct Camera { vec3 up; vec3 right; vec3 forward; vec3 position; float fov; float focalDist; float aperture; };

vec2 seed;

uniform Camera camera;
uniform vec2 screenResolution;
