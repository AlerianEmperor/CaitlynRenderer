bool hit_bbox4_prune(Ray r, vec3 bmin, vec3 bmax, vec3 invdir, float t, out float tl)
{
    bvec3 is_pos = greaterThanEqual(invdir, vec3(0.0));

    vec3 t1 = mix(bmax, bmin, is_pos);
    t1 = (t1 - r.o) * invdir;
    tl = max(max(t1.x, t1.y), t1.z);

    if(tl >= t)
        return false;

    vec3 t2 = mix(bmin, bmax, is_pos);
    t2 = (t2 - r.o) * invdir;

    float th = min(min(t2.x, t2.y), t2.z);

    return (th >= 0) && (th >= tl);// && 
}

