bool trace_bvh_dfs_bitstack(Ray r, out HitRecord rec)
{
    float t = inf;
    const vec3 invdir = 1.0f / (r.d);

    // --- KH?I T?O BIT-STACK SIÊU NH? (THAY TH? HOÀN TOÀN M?NG STK[32]) ---
    // Ch? t?n ?úng 4 bytes thanh ghi duy nh?t, gi?i phóng 100% dung l??ng ph?n c?ng
    uint bit_stk = 0u; 
    
    // M?ng l?u v?t l?ch s? ID d?c theo ?? sâu cây ?? ph?c v? vi?c quay ng??c (Backtracking)
    // Cây cao t?i ?a 32 t?ng thì m?ng này ch? c?n l?u các m?c ranh gi?i nh?y t?ng r?t nh?
    int path_nodes[32]; 
    int current_depth = 0;
    // ---------------------------------------------------------------------

    int ind = 0;
    
    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        if (range == 0) 
        {
            int leftIndex  = ind + 1; 
            int rightIndex = int(bmin.w); 
            float tl1, th1, tl2, th2;
            
            // T?n d?ng c? ch? nh?n di?n kho?ng cách t hi?n t?i ?? xén h?p s?m t? câu h?i tr??c c?a bác
            th1 = hit_bbox4(r, bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz, invdir, tl1);
            th2 = hit_bbox4(r, bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz, invdir, tl2);

            if (tl1 >= t) th1 = -1.0f;
            if (tl2 >= t) th2 = -1.0f;

            bool left  = (tl1 <= th1) && (th1 > 0.0f);
            bool right = (tl2 <= th2) && (th2 > 0.0f);

            if (left && right)
            {
                // ?úng logic DFS: ??y con xa h?n vào Bit-Stack b?ng toán t? d?ch bit (Shift)
                if (tl1 < tl2) 
                { 
                    // L?u d?u: ?ánh bit 1 t?i t?ng hi?n t?i ?? ?ánh d?u nhánh PH?I c?n quay l?i cày sau
                    bit_stk |= (1u << uint(current_depth)); 
                    path_nodes[current_depth] = rightIndex;
                    
                    current_depth++;
                    ind = leftIndex; 
                }
                else 
                { 
                    // L?u d?u nhánh TRÁI c?n quay l?i cày sau
                    bit_stk |= (1u << uint(current_depth)); 
                    path_nodes[current_depth] = leftIndex;
                    
                    current_depth++;
                    ind = rightIndex; 
                }
                continue;
            }
            else if (left)  
            { 
                current_depth++;
                ind = leftIndex;  
                continue; 
            }
            else if (right) 
            { 
                current_depth++;
                ind = rightIndex; 
                continue; 
            }
        }   
        else 
        {
            // X? LÝ NÚT LÁ: Duy?t danh sách tam giác (Hàm MT chu?n t?i ?u nh?t c?a bác)
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = end - 1; i >= start; --i) 
            { 
                hit_triangle2(r, i, rec, t); 
            }
        }

        // ============================================================
        // L?NH POP B?NG TOÁN T? BIT SIÊU T?C (BIT-STACK BACKTRACKING)
        // ============================================================
        // L?nh findMSB() là hàm n?i trú ph?n c?ng c?a GPU, tìm ki?m bit 1 cao nh?t ch? trong 1 chu k?
        int next_branch_depth = findMSB(bit_stk);

        if (next_branch_depth != -1)
        {
            // L?y ID nút c?n duy?t ti?p t? m?ng v?t l?u tr?
            ind = path_nodes[next_branch_depth];
            
            // Xóa bit 1 ?ã x? lý b?ng toán t? ??o bit AND NOT
            bit_stk &= ~(1u << uint(next_branch_depth));
            current_depth = next_branch_depth + 1;
        }
        else
        {
            // Bit-stack hoàn toàn tr?ng r?ng -> K?t thúc toàn b? ti?n trình duy?t cây
            ind = -1;
        }
    }
    
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

