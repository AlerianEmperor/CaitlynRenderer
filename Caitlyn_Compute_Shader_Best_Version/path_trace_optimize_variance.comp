    float Am_y = Ay - T_plane * pr.d[(pr.ky == 0) ? 0 : ((pr.ky == 1) ? 1 : 2)];

    // Th? hàm C?nh 2D (Edge Tests) ?? tìm t?a ?? Barycentric chu?n
    float u = (Am_x * Cy - Am_y * Cx) * inv_nu;
    if (u < 0.0f || u > 1.0f) return false;

    float v = (Bx * Am_y - By * Am_x) * inv_nu;
    if (v < 0.0f || u + v > 1.0f) return false;

    // Kh?p 100% v?i h? Barycentric c?a Möller-Trumbore -> S?a hoàn toàn l?i Texture
    t = T_plane;
    rec.u = u;
