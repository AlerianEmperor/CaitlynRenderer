bool hit_triangle_woop(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz;
    vec3 v2 = vertices[triIndex.z].xyz;

    // 1. Xác ??nh tr?c chi?m ?u th? (Dominant Axis) c?a h??ng tia
    // (M?o: Có th? tính s?n kz, kx, ky ngoài vòng l?p và truy?n vào làm uniform/bi?n c?c b? ?? t?ng t?c h?n n?a!)
    vec3 abs_d = abs(r.d);
    int kz = (abs_d.x > abs_d.y) ? ((abs_d.x > abs_d.z) ? 0 : 2) : ((abs_d.y > abs_d.z) ? 1 : 2);
    int kx = (kz + 1 == 3) ? 0 : kz + 1;
    int ky = (kx + 1 == 3) ? 0 : kx + 1;

    // Hoán ??i h??ng n?u h??ng tia b? âm ?? gi? v?ng th? t? bao quanh (Winding Order)
    if (r.d[kz] < 0.0f) {
        int tmp = kx; kx = ky; ky = tmp;
    }

    // 2. Tính h?ng s? bi?n ??i tr??t (Shear Constants)
    float inv_d_kz = 1.0f / r.d[kz];
    float sx = r.d[kx] * inv_d_kz;
    float sy = r.d[ky] * inv_d_kz;
    float sz = inv_d_kz;

    // 3. T?nh ti?n các ??nh tam giác t??ng ??i v?i g?c tia
    vec3 p0 = v0 - r.o;
    vec3 p1 = v1 - r.o;
    vec3 p2 = v2 - r.o;

    // Chi chi?u 3D sang không gian tr??t 2D
    float p0x = p0[kx] - sx * p0[kz];
    float p0y = p0[ky] - sy * p0[kz];
    float p1x = p1[kx] - sx * p1[kz];
    float p1y = p1[ky] - sy * p1[kz];
    float p2x = p2[kx] - sx * p2[kz];
    float p2y = p2[ky] - sy * p2[kz];

    // 4. Tính toán hàm C?nh 2D (Edge Functions) ??i di?n cho t?a ?? Barycentric ch?a chu?n hóa
    float u = p2x * p1y - p2y * p1x;
    float v = p0x * p2y - p0y * p2x;
    float w = p1x * p0y - p1y * p0x;

    // Ki?m tra d?u s?m: N?u các hàm c?nh không ??ng d?u, tia n?m ngoài tam giác -> Tr??t!
    if ((u < 0.0f || v < 0.0f || w < 0.0f) && (u > 0.0f || v > 0.0f || w > 0.0f)) {
        return false;
    }

    // Tính ??nh th?c chu?n hóa
    float det = u + v + w;
    if (det == 0.0f) return false;
    float inv_det = 1.0f / det;

    // 5. Tính toán kho?ng cách giao c?t tHit d?c theo tr?c chính
    float t_hit = (u * p0[kz] + v * p1[kz] + w * p2[kz]) * sz * inv_det;

    // Ki?m tra ranh gi?i kho?ng cách h?p l?
    if (t_hit > 0.0001f && t_hit < t)
    {
        t = t_hit;
        // Chu?n hóa t?a ?? Barycentric th?c t? ?? tr? v? ph?c v? n?i suy VN/VT
        rec.u = u * inv_det;
        rec.v = v * inv_det;
        rec.triangle_ind = i;
        rec.mtl_ind = triIndex.w;
        return true;
    }

    return false;
}

//best
bool hitTriangleNoRec(in Ray r, int i, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz;
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    //vec3 pv = cross(r.d, v2);

    float det = v1.x * pv.x + v1.y * pv.y + v1.z * pv.z;
    if (abs(det) < 1e-6) return false;
    //if (det == 0.0) return false;

    float inv_det = 1.0 / det;
    vec3 tv = r.o - v0;

    float u = (tv.x * pv.x + tv.y * pv.y + tv.z * pv.z) * inv_det;
    if (u < 0.0 || u > 1.0) return false;

    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    float v = (r.d.x * qv.x + r.d.y * qv.y + r.d.z * qv.z) * inv_det;
    if (v < 0.0 || u + v > 1.0) return false;

    float tHit = (v2.x * qv.x + v2.y * qv.y + v2.z * qv.z) * inv_det;
    if (tHit <= 0.0 || tHit >= t) return false;

    return true;
}

void compute_normal_texcoord_and_material(inout HitRecord rec)
{
    int triangle_ind = rec.triangle_ind;
    int mtl_ind = (rec.mtl_ind);
    ivec4 vn = triangles[3 * triangle_ind + 1];
    
    if (vn.w == 0)
        rec.n = vn.xyz;
    else
    {
        vec3 vn0 = normals[vn.x].xyz;
        vec3 vn1 = normals[vn.y].xyz;
        vec3 vn2 = normals[vn.z].xyz;
        rec.n = interpolate(vn0, vn1, vn2, rec.u, rec.v);
    }
    
    rec.tex_ind = materials[4 * mtl_ind + 3];
    rec.emission = materials[4 * mtl_ind + 1];
    rec.specular = materials[4 * mtl_ind + 2];

    if (rec.tex_ind.x != -1)
    {
        ivec4 vt = triangles[3 * triangle_ind + 2];
        vec2 vt0 = texcoords[vt.x].xy;
        vec2 vt1 = texcoords[vt.y].xy;
        vec2 vt2 = texcoords[vt.z].xy;
        rec.texcoord = interpolate(vt0, vt1, vt2, rec.u, rec.v);
        rec.albedo = texture(albedo_textures, vec3(rec.texcoord, rec.tex_ind.x));
    }
    else
        rec.albedo = materials[4 * mtl_ind];
}

bool trace_bvh_dfs_vectorized(Ray r, out HitRecord rec)
{
    int stk[32]; 
    int ptr = 0;
    float t = inf;
    const vec3 invdir = 1.0f / (r.d);
   
    int ind = 0;
    
    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        if (range == 0) 
        {
            int leftIndex  = ind + 1; 
            int rightIndex = int(bmin.w); 
            float tl1, th1, tl2, th2;
            
            // THAY TH?: G?i 1 hàm g?p duy nh?t, tri?t tiêu vi?c g?i hàm và ép xung ALU ph?n c?ng
            hit_double_bbox(r, invdir, 
                            bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz,
                            bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz,
                            tl1, th1, tl2, th2);

            bool left  = (tl1 <= th1) && (th1 > 0.0f) && (tl1 < t);
            bool right = (tl2 <= th2) && (th2 > 0.0f) && (tl2 < t);

            if (left && right)
            {
                if (tl1 < tl2) { stk[ptr++] = rightIndex; ind = leftIndex; }
                else { stk[ptr++] = leftIndex; ind = rightIndex; }
                continue;
            }
            else if (left)  { ind = leftIndex;  continue; }
            else if (right) { ind = rightIndex; continue; }
        }   
        else 
        {
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = end - 1; i >= start; --i) 
            { 
                // Gi? nguyên hàm chu?n hit_triangle2 ch?y ngon nh?t c?a bác
                hit_triangle2(r, i, rec, t); 
            }
        }
        ind = (ptr > 0) ? stk[--ptr] : -1;
    }
    
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

