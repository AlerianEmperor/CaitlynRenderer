void hit_double_bbox(Ray r, vec3 invdir, 
                     vec3 bmin1, vec3 bmax1, 
                     vec3 bmin2, vec3 bmax2, 
                     out float tl1, out float th1, 
                     out float tl2, out float th2)
{
    bvec3 is_pos = greaterThanEqual(invdir, vec3(0.0));

    // Ch?n min/max cho h?p 1
    vec3 t1_box1 = mix(bmax1, bmin1, is_pos);
    vec3 t2_box1 = mix(bmin1, bmax1, is_pos);
    t1_box1 = (t1_box1 - r.o) * invdir;
    t2_box1 = (t2_box1 - r.o) * invdir;

    // Ch?n min/max cho h?p 2 (GPU s? ch?y song song lu?ng này v?i h?p 1)
    vec3 t1_box2 = mix(bmax2, bmin2, is_pos);
    vec3 t2_box2 = mix(bmin2, bmax2, is_pos);
    t1_box2 = (t1_box2 - r.o) * invdir;
    t2_box2 = (t2_box2 - r.o) * invdir;

    // Gom l?nh max/min ph?n c?ng
    tl1 = max(max(t1_box1.x, t1_box1.y), t1_box1.z);
    th1 = min(min(t2_box1.x, t2_box1.y), t2_box1.z);

    tl2 = max(max(t1_box2.x, t1_box2.y), t1_box2.z);
    th2 = min(min(t2_box2.x, t2_box2.y), t2_box2.z);
}

bool hit_triangle(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz - v0;
    vec3 v2 = vertices[triIndex.z].xyz - v0;

    vec3 pv = vec3(
        r.d.y * v2.z - r.d.z * v2.y,
        r.d.z * v2.x - r.d.x * v2.z,
        r.d.x * v2.y - r.d.y * v2.x
    );

    vec3 tv = r.o - v0;
    vec3 qv = vec3(
        tv.y * v1.z - tv.z * v1.y,
        tv.z * v1.x - tv.x * v1.z,
        tv.x * v1.y - tv.y * v1.x
    );

    vec4 uvt;
    uvt.x = dot(tv, pv);
    uvt.y = dot(r.d, qv);
    uvt.z = dot(v2, qv);
    float inv_det = 1.0f / dot(v1, pv);

    uvt.xyz = uvt.xyz * inv_det;
    uvt.w = 1.0 - uvt.x - uvt.y;
    
    if (all(greaterThanEqual(uvt, vec4(0.0f))) && uvt.z < t)
    {
        t = uvt.z;
        rec.u = uvt.x;
        rec.v = uvt.y;
        rec.triangle_ind = i;
        rec.mtl_ind = (triIndex.w);
        return true;
    }   
    return false;
}

bool hit_triangle2(Ray r, int i, inout HitRecord rec, inout float t)
{
    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = -vertices[triIndex.x].xyz; 
    vec3 v1 = vertices[triIndex.y].xyz + v0;
    vec3 v2 = vertices[triIndex.z].xyz + v0;

    vec3 pv = cross(r.d, v2);
    float det = dot(v1, pv);

    //front face only
    // if 2 face use abs(det)
    if (abs(det) < 1e-6) return false;
    float inv_det = 1.0f / det;

    vec3 tv = r.o + v0;
    float u = dot(tv, pv) * inv_det;
    if (u < 0.0 || u > 1.0 ) return false;

    vec3 qv = cross(tv, v1);
    float v = dot(r.d, qv) * inv_det;
    if (v < 0.0 || v > 1.0 || u + v > 1.0) return false;

    float t_hit = dot(v2, qv) * inv_det;
    
    if (t_hit > 0.0 && t_hit < t)
    {
        t = t_hit;
        rec.u = u;
        rec.v = v;
        rec.triangle_ind = i;
        rec.mtl_ind = triIndex.w;
        return true;
    }   
    return false;
}
