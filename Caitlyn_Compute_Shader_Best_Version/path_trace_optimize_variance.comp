    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz;
    vec3 v1 = vertices[triIndex.y].xyz;
    vec3 v2 = vertices[triIndex.z].xyz;

    // 1. T?nh ti?n g?c tam giác v? g?c tia
    vec3 A = v0 - pr.o;
    vec3 B = v1 - v0;
    vec3 C = v2 - v0;

    // 2. Chuy?n ??i sang không gian tr??t 2D b?ng h?ng s? ma tr?n pr.Sx/Sy/Sz
    // Kh?c ph?c tri?t ?? l?i tính toán t?a ?? giao ?i?m ph?ng làm sinh Point Cloud
    float Ax = A[pr.kx] - pr.Sx * A[3 - pr.kx - pr.ky];
