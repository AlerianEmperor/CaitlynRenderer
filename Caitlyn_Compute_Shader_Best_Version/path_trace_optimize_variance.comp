    imageStore(img_output, pixelCoords, vec4(pixelColor + accumulate_color, 1.0f));


    // ============================================================
    // THU?T TOÁN WELFORD TÍNH VARIANCE ONLINE (CHUY?N HÓA SANG GLSL)
    // ============================================================
    // Trích xu?t s?c ?? (Luminance) c?a m?u màu hi?n t?i
    float new_luminance = dot(pixelColor, vec3(0.2126, 0.7152, 0.0722));
        
    float old_mean = history_data.r;
    float old_m2 = history_data.a;
        
    // 1. C?p nh?t giá tr? trung bình ch?y l?y ti?n (Running Mean)
    float current_sample_weight = 1.0f / float(currentFrameSample + 1);
    float new_mean = mix(old_mean, new_luminance, current_sample_weight);
        
    // 2. Tính toán t?ng bình ph??ng kho?ng cách sai s? l?y ti?n (Running M2)
    float delta0 = new_luminance - old_mean;
    float delta1 = new_luminance - new_mean;
    float new_m2 = old_m2 + delta0 * delta1;

    // L?u ng??c l?i Texture phân tích ?? chu?n b? cho khung hình ti?p theo
    imageStore(variance_history_tex, pixelCoords, vec4(new_mean, 0.0f, 0.0f, new_m2));
}

