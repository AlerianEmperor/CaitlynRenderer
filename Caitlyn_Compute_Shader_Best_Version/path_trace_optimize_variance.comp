    float inv_nu = 1.0f / nu;

    // 4. Tính toán kho?ng cách tHit chu?n d?c theo tr?c chính Dominant (kz)
    // kz luôn b?ng (3 - kx - ky)
    float T_plane = A[3 - pr.kx - pr.ky] * pr.Sz;
    if (T_plane <= 0.0001f || T_plane >= t) return false;

    // 5. Th? hàm C?nh 2D (Edge Tests) ?? tính t?a ?? Barycentric chu?n
    // S?a l?i ??o ng??c d?u khi?n tia b? hi?u sai ranh gi?i Edge
    float u = (Ax * Cy - Ay * Cx) * inv_nu;
    if (u < 0.0f || u > 1.0f) return false;

    float v = (Bx * Ay - By * Ax) * inv_nu;
    if (v < 0.0f || u + v > 1.0f) return false;

    // Trúng tam giác hoàn ch?nh -> Tr? d? li?u ??ng b? Möller-Trumbore
    t = T_plane;
    rec.u = u;
    rec.v = v;
    rec.triangle_ind = i;
    rec.mtl_ind = triIndex.w;
    return true;
}

bool hitTriangleNoRec_wald(PrecomputedRay pr, int i, float max_t)
{
    /*ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz;
    vec3 v1 = vertices[triIndex.y].xyz;
    vec3 v2 = vertices[triIndex.z].xyz;

    // T?nh ti?n các ??nh t??ng ??i v?i g?c tia shadow
    vec3 A = v0 - pr.o;
    vec3 B = v1 - v0;
    vec3 C = v2 - v0;

    // Trích xu?t t?a ?? ph?ng b?ng Swizzling ph?n c?ng nhanh chóng
    float Ax = (pr.kx == 0) ? A.x : ((pr.kx == 1) ? A.y : A.z);
    float Ay = (pr.ky == 0) ? A.x : ((pr.ky == 1) ? A.y : A.z);
    
    float Bx = (pr.kx == 0) ? B.x : ((pr.kx == 1) ? B.y : B.z);
    float By = (pr.ky == 0) ? B.x : ((pr.ky == 1) ? B.y : B.z);
    
    float Cx = (pr.kx == 0) ? C.x : ((pr.kx == 1) ? C.y : C.z);
    float Cy = (pr.ky == 0) ? C.x : ((pr.ky == 1) ? C.y : C.z);

    // Tính ??nh th?c ph?ng (2D Determinant) thay th? hoàn toàn phép Cross 3D
    float nu = Bx * Cy - By * Cx;
    if (abs(nu) < 1e-6) return false;
    float inv_nu = 1.0f / nu;

    // Trích xu?t t?a ?? d?c theo tr?c chính Dominant (kz) ?? tính tHit
    float Az = (3 - pr.kx - pr.ky == 0) ? A.x : ((3 - pr.kx - pr.ky == 1) ? A.y : A.z);

    // Tính kho?ng cách giao c?t tr?c ti?p d?c tr?c chính
    float T_plane = Az * pr.Sz;
    if (T_plane <= 0.0001f || T_plane >= max_t) return false;

    // Tìm t?a ?? giao ?i?m ph?ng sau khi th?c hi?n phép tr??t (Sheared coordinate)
    float dx = (pr.kx == 0) ? pr.d.x : ((pr.kx == 1) ? pr.d.y : pr.d.z);
    float dy = (pr.ky == 0) ? pr.d.x : ((pr.ky == 1) ? pr.d.y : pr.d.z);
    float Am_x = Ax - T_plane * dx;
    float Am_y = Ay - T_plane * dy;

    // Th? hàm C?nh 2D (Edge Tests) ?? ki?m tra ranh gi?i tam giác ph?ng
    float u = (Am_x * Cy - Am_y * Cx) * inv_nu;
    if (u < 0.0f || u > 1.0f) return false;

    float v = (Bx * Am_y - By * Am_x) * inv_nu;
    if (v < 0.0f || u + v > 1.0f) return false;

    return true; // Trúng b?t k? v?t c?n nào, xác nh?n b? bóng râm ngay*/

    ivec4 triIndex = triangles[3 * i];
    vec3 v0 = vertices[triIndex.x].xyz;
    vec3 v1 = vertices[triIndex.y].xyz;
    vec3 v2 = vertices[triIndex.z].xyz;

    vec3 A = v0 - pr.o;
    vec3 B = v1 - v0;
    vec3 C = v2 - v0;

    int kz = 3 - pr.kx - pr.ky;

    float Ax = A[pr.kx] - pr.Sx * A[kz];
    float Ay = A[pr.ky] - pr.Sy * A[kz];
    
    float Bx = B[pr.kx] - pr.Sx * B[kz];
    float By = B[pr.ky] - pr.Sy * B[kz];
    
    float Cx = C[pr.kx] - pr.Sx * C[kz];
    float Cy = C[pr.ky] - pr.Sy * C[kz];

    float nu = Bx * Cy - By * Cx;
    if (abs(nu) < 1e-6) return false;
    float inv_nu = 1.0f / nu;

    float T_plane = A[kz] * pr.Sz;
    if (T_plane <= 0.0001f || T_plane >= max_t) return false;

    float u = (Ax * Cy - Ay * Cx) * inv_nu;
    if (u < 0.0f || u > 1.0f) return false;

    float v = (Bx * Ay - By * Ax) * inv_nu;
    if (v < 0.0f || u + v > 1.0f) return false;

    return true;
}

bool trace_bvh_dfs_wald(Ray r, out HitRecord rec)
{
    int stk[32]; 
    int ptr = 0;
    float t = inf;
    const vec3 invdir = 1.0f / (r.d);

    // --- KH?I TÍNH TOÁN TR??C H??NG TIA VÀ TR?C CHÍNH (PRECOMPUTED RAY) ---
    vec3 abs_d = abs(r.d);
    int kz = (abs_d.x > abs_d.y) ? ((abs_d.x > abs_d.z) ? 0 : 2) : ((abs_d.y > abs_d.z) ? 1 : 2);
    int kx = (kz + 1 == 3) ? 0 : kz + 1;
    int ky = (kx + 1 == 3) ? 0 : kx + 1;

    PrecomputedRay pr;
    pr.o = r.o;
    pr.d = r.d;
    pr.kx = kx;
    pr.ky = ky;
    pr.Sz = 1.0f / r.d[kz];
    pr.Sx = r.d[kx] * pr.Sz; // S?n sàng n?u c?n m? r?ng
    pr.Sy = r.d[ky] * pr.Sz;
    // ----------------------------------------------------------------------
   
    int ind = 0;
    
    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        if (range == 0) 
        {
            int leftIndex  = ind + 1; 
            int rightIndex = int(bmin.w); 
            float tl1, th1, tl2, th2;
            
            th1 = hit_bbox4(r, bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz, invdir, tl1);
            th2 = hit_bbox4(r, bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz, invdir, tl2);

            bool left  = (tl1 <= th1) && (th1 > 0.0f) && (tl1 < t);
            bool right = (tl2 <= th2) && (th2 > 0.0f) && (tl2 < t);

            if (left && right)
            {
                if (tl1 < tl2) { stk[ptr++] = rightIndex; ind = leftIndex; }
                else { stk[ptr++] = leftIndex; ind = rightIndex; }
                continue;
            }
            else if (left)  { ind = leftIndex;  continue; }
            else if (right) { ind = rightIndex; continue; }
        }   
        else 
        {
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = end - 1; i >= start; --i) 
            { 
                // G?i hàm Wald siêu t?c truy?n pr vào thay vì r
                hit_triangle_wald(pr, i, rec, t); 
            }
        }
        ind = (ptr > 0) ? stk[--ptr] : -1;
    }
    
    if (t < inf)
    {
        rec.t = t;
        compute_normal_texcoord_and_material(rec);
        return true;
    }
    return false;
}

bool hit_shadow_dfs_wald(Ray r, float max_t)
{
    int stk[32];
    int ptr = 0;
    vec3 invdir = 1.0f / r.d;

    // --- KH?I TÍNH TOÁN TR??C H??NG TIA VÀ TR?C CHÍNH (PRECOMPUTED RAY) ---
    vec3 abs_d = abs(r.d);
    int kz = (abs_d.x > abs_d.y) ? ((abs_d.x > abs_d.z) ? 0 : 2) : ((abs_d.y > abs_d.z) ? 1 : 2);
    int kx = (kz + 1 == 3) ? 0 : kz + 1;
    int ky = (kx + 1 == 3) ? 0 : kx + 1;

    PrecomputedRay pr;
    pr.o = r.o;
    pr.d = r.d;
    pr.kx = kx;
    pr.ky = ky;
    pr.Sz = 1.0f / r.d[kz];
    pr.Sx = r.d[kx] * pr.Sz;
    pr.Sy = r.d[ky] * pr.Sz;
    // ----------------------------------------------------------------------

    int ind = 0;

    while (ind != -1)
    {
        int n = ind << 1; 
        vec4 bmin = bvh[n];
        vec4 bmax = bvh[n + 1];
        int range = int(bmax.w);

        if (range == 0) 
        {
            int leftIndex  = ind + 1; 
            int rightIndex = int(bmin.w); 
            float tl1, th1, tl2, th2;
            
            // Hàm hit_bbox4 v?n nh?n Ray r thô nguyên b?n c?a b?n ?? ki?m tra h?p AABB
            th1 = hit_bbox4(r, bvh[leftIndex * 2].xyz,  bvh[leftIndex * 2 + 1].xyz,  invdir, tl1);
            th2 = hit_bbox4(r, bvh[rightIndex * 2].xyz, bvh[rightIndex * 2 + 1].xyz, invdir, tl2);
            
            bool left  = (tl1 <= th1) && (th1 > 0.0) && (tl1 < max_t);
            bool right = (tl2 <= th2) && (th2 > 0.0) && (tl2 < max_t);
            
            if (left && right) 
            { 
                if (tl1 < tl2) { stk[ptr++] = rightIndex; ind = leftIndex; }
                else { stk[ptr++] = leftIndex; ind = rightIndex; }
                continue;
            }
            else if (left)  { ind = leftIndex;  continue; }
            else if (right) { ind = rightIndex; continue; }
        }
        else 
        {
            int start = int(bmin.w);
            int end   = start + range;
            for (int i = end - 1; i >= start; --i) 
            {
                // G?i hàm ki?m tra tam giác bóng ph?ng Wald truy?n pr vào siêu t?c
                if (hitTriangleNoRec_wald(pr, i, max_t)) return true;
            }
        }   
        ind = (ptr > 0) ? stk[--ptr] : -1;
    }
    return false;
}

vec3 path_trace_wald(inout Ray r)
{
	vec3 L = vec3(0.0f);
	vec3 T = vec3(1.0f);

	float prev_pdf = 1.0f;
	bool is_specular = true;

	for(int i = 0; i < 3; ++i)
	{
		if (i >= 1)
		{
			// Xác su?t s?ng sót d?a trên thành ph?n n?ng l??ng l?n nh?t
			float p = max(T.x, max(T.y, T.z));
			
			// Gi?i h?n RR (Capped Russian Roulette) ?? ki?m soát bi?n ??ng n?ng l??ng
			if (p > 0.6f) p = 0.6f; 

			if (rand() > p)
			{
				break; // Ch?m d?t ???ng ?i c?a tia s?m
			}

			// Nhân bù n?ng l??ng cho tia s?ng sót
			T /= p; 
		}

		HitRecord rec;
		
		if(trace_bvh_dfs_wald(r, rec))
		{
        //return rec.n;
			float cos_incident = dot(r.d, rec.n);
			vec3 original_n = rec.n;

			if (cos_incident > 0)
				rec.n = -rec.n;

			vec4 emission = rec.emission;

			// --- X? LÝ NGU?N PHÁT SÁNG TRÚNG TIA GIÁN TI?P ---
			if(emission.w != -1)
			{
				if(!is_specular)
				{
					vec3 light_direction = r.d * rec.t;
					float length2 = dot(light_direction, light_direction); // T?i ?u: Dùng dot thay vì length * length ?? gi?m chu k? tính toán
					
					light_direction = normalize(light_direction);
					float cos_light = -dot(light_direction, rec.n);

					int light_index = int(emission.w);
					Light4 l = lights[light_index];
					vec3 light_area_pdf = l.area_pdf.xyz;
					
					float pdf_light = length2 / (light_area_pdf.x * cos_light) * light_area_pdf.y;
					float mis_weight = power_heuristic(prev_pdf, pdf_light);
					
					L += T * emission.xyz * mis_weight;
					return L;
				}
				else
				{
					L += T * emission.xyz;
					return L;
				}
			}

			vec3 hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;
			vec4 specular = rec.specular;

			// --- X? LÝ L?Y M?U ÁNH SÁNG TR?C TI?P (NEE) ---
			if(specular.w == 0)
			{
				int light_index = int(rand() * numLights);
				vec3 light_position = sample_light_position(light_index);
				vec3 light_direction = light_position - hit_point;

				float length = length(light_direction);
				light_direction /= length; // T?i ?u hóa phép chu?n hóa vector (Tri?t tiêu 1 l?nh toán h?c)

				float cos_mtl = dot(light_direction, original_n);

				Light4 l = lights[light_index];
				vec3 light_normal = l.n.xyz;
				float cos_light = dot(light_direction, light_normal);

				// Ch? b?n tia shadow khi các góc hình h?c h?p lý
				if(cos_mtl > 0.0f && cos_light < 0.0f)
				{
					Ray light_ray = Ray(hit_point, light_direction);

					if (!hit_shadow_dfs_wald(light_ray, length))		
					{	
						vec3 light_emission = l.e.xyz;
						vec3 light_area_pdf = l.area_pdf.xyz;
						
						float pdf_light = (length * length) / (light_area_pdf.x * -cos_light) * light_area_pdf.y;
						vec3 bsdf_eval = diffuse_bsdf(r, rec, light_direction);
						float bsdf_pdf = diffuse_pdf(r, rec, light_direction);

						float mis_weight = power_heuristic(pdf_light, bsdf_pdf);

						// Hàm tr? v? n?ng l??ng thô t? nhiên, không r? nhánh min/clamp ?? l?y l?i 11.7 FPS
						L += T * light_emission * bsdf_eval * mis_weight / pdf_light;
					}
				}
			}

			// --- SINH TIA M?I CHO B??C N?Y GIÁN TI?P TI?P THEO ---
			vec3 sample_direction = diffuse_sample(r, rec.n);
			vec3 new_hit_point = r.o + r.d * rec.t + rec.n * 0.0002f;

			vec3 sample_eval = diffuse_bsdf(r, rec, sample_direction);
			float bsdf_pdf = diffuse_pdf(r, rec, sample_direction);

			T *= sample_eval;

			// Ki?m tra n?ng l??ng t?i thi?u ?? c?t t?a tia y?u s?m
			float energy = max(T.x, max(T.y, T.z));
			if (energy < 0.01f) 
			{
				break; 
			}

			prev_pdf = bsdf_pdf;
			is_specular = false;

			r.o = new_hit_point;
			r.d = sample_direction;
		}
		else
		{
			return L;
		}
	}
	return L;
}

