void mainb()
{
    ivec2 pixelCoords = ivec2(gl_GlobalInvocationID.xy);

    if (pixelCoords.x >= int(screenResolution.x) || pixelCoords.y >= int(screenResolution.y))  
        return;   

    if (gl_LocalInvocationIndex == 0)
        shared_workgroup_active = false;

    float current_variance = 0.0f;
    vec4 history_data = imageLoad(variance_history_tex, pixelCoords);
    float history_mean_lum = history_data.r; // ?? sáng trung bình l?ch s?
    float history_m2 = history_data.a;

    // Ki?m tra xem pixel này có thu?c vùng ngu?n sáng m?nh c? ??nh không
    bool is_light_source = (history_mean_lum > 1.5f && currentFrameSample > MIN_SAMPLES);

    // N?u KHÔNG PH?I là ngu?n sáng, ta m?i tính toán Variance bình th??ng ?? xét h?i t?
    if (!is_light_source)
    {
        if (currentFrameSample > MIN_SAMPLES)
            current_variance = history_m2 / float(currentFrameSample - 1);
        else
            current_variance = 1.0f;

        if (current_variance > VARIANCE_THRESHOLD)
            shared_workgroup_active = true;
    }

    // ??ng b? hóa tr?ng thái nhóm sau khi các pixel không ph?i ngu?n sáng b? phi?u
    memoryBarrierShared();
    barrier();

    // ============================================================
    // X? LÝ ?ÁNH CH?N NGU?N SÁNG & B?Y DIVERGENCE 
    // ============================================================
    if (!shared_workgroup_active)
    {
        // N?u c? c?m 8x8 ?ã h?i t? HO?C ô này ch? ch?a toàn ngu?n sáng c? ??nh:
        if (is_light_source)
        {
            // Thay vì trace ti?p, ta n?p giá tr? c? ??nh l?y ti?n tr?c ti?p ?? di?t l?i xám màu
            vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f)) / screenResolution;
            vec3 accumulate_color = texture(accumulate_tex, texCoords).xyz;
            
            // Gi? cho n?ng l??ng vùng sáng t?ng tr??ng tuy?n tính chính xác theo giá tr? l?ch s? c?a nó
            // (B?n có th? nhân history_mean_lum v?i màu s?c thô c?a l?a n?u mu?n, 
            // nh?ng c?ng tr?c ti?p history_mean_lum là gi?i pháp gi? màu chu?n nh?t)
            vec3 constant_light_energy = vec3(history_mean_lum); 
            
            imageStore(img_output, pixelCoords, vec4(constant_light_energy + accumulate_color, 1.0f));
        }
        return; // Thoát s?m ??ng b? cho toàn b? c?m 8x8, gi?i phóng 100% tài nguyên!
    }

    // --- TI?N TRÌNH PATH TRACING G?C (Ch? ch?y khi c?m ch?a h?i t? và pixel không ph?i ngu?n sáng) ---
    vec2 texCoords = (vec2(pixelCoords) + vec2(0.5f)) / screenResolution;
	
    float jitter_offset_x = (currentFrameSample % 2 == 0) ? 0.25f : -0.25f;
    float jitter_offset_y = ((currentFrameSample / 2) % 2 == 0) ? 0.25f : -0.25f;
    vec2 jittered_uv = (vec2(pixelCoords) + vec2(0.5f) + vec2(jitter_offset_x, jitter_offset_y)) / screenResolution;
    seed = jittered_uv;

    float r1 = 2.0f * rand();
    float r2 = 2.0f * rand();

    vec2 jitter;
    jitter.x = r1 < 1.0 ? sqrt(r1) - 1.0f : 1.0f - sqrt(2.0f - r1);
    jitter.y = r2 < 1.0 ? sqrt(r2) - 1.0f : 1.0f - sqrt(2.0f - r2);
    jitter /= (screenResolution * 0.5f);

    vec2 d = (2.0f * texCoords - 1.0f) + jitter;

    float tan_fov = tan(camera.fov * 0.5f);
    d.x *= screenResolution.x / screenResolution.y * tan_fov;
    d.y *= tan_fov;

    vec3 rayDir = normalize(d.x * camera.right + d.y * camera.up + camera.forward);
    Ray ray = Ray(camera.position, rayDir);

    vec3 accumulate_color = texture(accumulate_tex, texCoords).xyz;
    
    // N?u pixel hi?n t?i là ngu?n sáng, ta gán luôn giá tr? thô, ng??c l?i m?i tính toán tia n?ng
    vec3 pixelColor = is_light_source ? vec3(history_mean_lum) : path_trace(ray);

    imageStore(img_output, pixelCoords, vec4(pixelColor + accumulate_color, 1.0f));

    // ============================================================
    // THU?T TOÁN WELFORD TÍNH VARIANCE ONLINE
    // ============================================================
    float new_luminance = dot(pixelColor, vec3(0.2126, 0.7152, 0.0722));
        
    float old_mean = history_data.r;
    float old_m2 = history_data.a;
        
    float current_sample_weight = 1.0f / float(currentFrameSample + 1);
    float new_mean = mix(old_mean, new_luminance, current_sample_weight);
        
    float delta0 = new_luminance - old_mean;
    float delta1 = new_luminance - new_mean;
    float new_m2 = old_m2 + delta0 * delta1;

    imageStore(variance_history_tex, pixelCoords, vec4(new_mean, 0.0f, 0.0f, new_m2));
}